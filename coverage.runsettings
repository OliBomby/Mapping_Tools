<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Mapping_Tools.Core]*,[Mapping_Tools.Application]*,[Mapping_Tools.Infrastructure]*,[Mapping_Tools.Desktop]*</Include>
          <ExcludeByFile>**/obj/**,**/MathUtil/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
