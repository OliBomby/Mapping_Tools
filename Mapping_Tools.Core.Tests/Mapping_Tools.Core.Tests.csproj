  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapping_Tools.Core\Mapping_Tools.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Mapping_Tools_Tests\Resources\TestStoryboard.osb" Link="Resources\TestStoryboard.osb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Mapping_Tools_Tests\Resources\EmptyTestMap.osu" Link="Resources\EmptyTestMap.osu">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Mapping_Tools_Tests\Resources\ComplicatedTestMap.osu" Link="Resources\ComplicatedTestMap.osu">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
