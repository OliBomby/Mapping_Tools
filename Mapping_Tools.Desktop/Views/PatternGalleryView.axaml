<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mapping_Tools.Desktop.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:corePattern="using:Mapping_Tools.Core.Tools.PatternGallery"
             x:Class="Mapping_Tools.Desktop.Views.PatternGalleryView"
             x:Name="Root"
             x:DataType="vm:PatternGalleryViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid Margin="0,0,0,10" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <controls:ToolViewHeader Title="Pattern Gallery"
                                         IsQuickRunSupported="True"
                                         HelpText="Pattern Gallery lets you collect reusable patterns from beatmaps, preview them, organize them into groups, and place them into the beatmap currently open in osu!. Select one or more patterns, choose the placement options, and click Run." />
                <Menu Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <MenuItem Header="Collection">
                        <MenuItem Header="Rename collection" Command="{Binding RenameCollectionCommand}" />
                        <MenuItem Header="Import ZIP" Command="{Binding ImportCollectionCommand}" />
                        <MenuItem Header="Export ZIP" Command="{Binding ExportCollectionCommand}" />
                        <MenuItem Header="Restore files" Command="{Binding RestoreCollectionCommand}" />
                    </MenuItem>
                </Menu>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="*,12,270">
                <Grid Grid.Column="0" RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PatternGalleryGroupViewModel">
                                    <Expander IsExpanded="True" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                                <TextBlock Opacity="0.65" Text="{Binding ItemCount, StringFormat='({0})'}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Patterns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PatternGalleryItemViewModel">
                                                    <materialControls:Card Width="170" Margin="4" Padding="5">
                                                        <Border PointerPressed="PatternPointerPressed"
                                                                DoubleTapped="PatternDoubleTapped"
                                                                Background="Transparent">
                                                            <Border.ContextMenu>
                                                                <ContextMenu Opened="PatternContextMenuOpened" />
                                                            </Border.ContextMenu>
                                                            <Grid RowDefinitions="110,Auto" ToolTip.Tip="Double-click to QuickRun this pattern.">
                                                                <controls:ObjectVisualiserControl Scene="{Binding Scene}"
                                                                                                  Fill="{DynamicResource MappingToolsTimelineAddedInnerBrush}"
                                                                                                  Stroke="{DynamicResource MaterialLightForegroundBrush}"
                                                                                                  ShowComboNumbers="True"
                                                                                                  ShowFollowLines="True"
                                                                                                  ComboNumberBrush="{DynamicResource MaterialLightForegroundBrush}"
                                                                                                  FollowLineBrush="{DynamicResource MaterialLightForegroundBrush}"
                                                                                                  Thickness="38"
                                                                                                  BorderThickness="0.08" />
                                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="2,5,2,0">
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              ToolTip.Tip="Include this pattern in the next export." />
                                                                    <TextBlock Grid.Column="1"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding Name}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </materialControls:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox materialAssists:TextFieldAssist.Label="Search"
                                     Text="{Binding SearchFilter, Mode=TwoWay}"
                                     ToolTip.Tip="Search for a pattern." />
                            <ComboBox Grid.Column="1" Width="150" Margin="8,0,0,0"
                                      Classes="compact"
                                      ItemsSource="{Binding SortableProperties}"
                                      SelectedItem="{Binding SortProperty, Mode=TwoWay}"
                                      materialAssists:ComboBoxAssist.Label="Sort by" />
                            <ComboBox Grid.Column="2" Width="120" Margin="8,0,0,0"
                                      Classes="compact"
                                      SelectedIndex="{Binding SortDirection, Mode=TwoWay}"
                                      materialAssists:ComboBoxAssist.Label="Direction">
                                <ComboBoxItem Content="Ascending" />
                                <ComboBoxItem Content="Descending" />
                            </ComboBox>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Classes="flat" Content="Select all" Command="{Binding SelectAllCommand}" />
                            <Button Classes="flat" Content="Clear" Command="{Binding ClearSelectionCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="{DynamicResource MaterialDividerBrush}" />

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding CollectionName}"
                                   PointerPressed="CollectionNamePointerPressed"
                                   ToolTip.Tip="Rename this collection." />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Add code" Command="{Binding AddCodeCommand}" ToolTip.Tip="Create a pattern from raw hit-object text." />
                            <Button Content="Add file" Command="{Binding AddFileCommand}" ToolTip.Tip="Import a pattern from an osu! file." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Add selected" Command="{Binding AddSelectedCommand}" ToolTip.Tip="Import the selected objects from the current editor map." />
                            <Button Content="Delete" Command="{Binding RemoveCommand}"
                                    PointerPressed="RemoveButtonPointerPressed"
                                    ToolTip.Tip="Delete selected patterns. Hold Shift to skip confirmation." />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Export options" />
                        <ComboBox ItemsSource="{Binding ExportTimeModes}"
                                  SelectedItem="{Binding ExportTimeMode, Mode=TwoWay}"
                                  materialAssists:ComboBoxAssist.Label="Export offset"
                                  ToolTip.Tip="Determines at what time to put the pattern." />
                        <TextBox IsVisible="{Binding CustomExportTimeVisible}"
                                 materialAssists:TextFieldAssist.Label="Custom export offset"
                                 Text="{Binding CustomExportTime, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                 ToolTip.Tip="Determines at what time to put the pattern for the custom offset mode." />
                        <TextBox materialAssists:TextFieldAssist.Label="Padding"
                                 Text="{Binding Padding, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                 ToolTip.Tip="Extra time in milliseconds around the patterns for deleting parts of the original map." />
                        <TextBox materialAssists:TextFieldAssist.Label="Parting distance"
                                 Text="{Binding PartingDistance, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                 ToolTip.Tip="Minimum number of beats required in a gap to split a pattern into smaller parts." />
                        <ComboBox ItemsSource="{Binding PatternOverwriteModes}"
                                  SelectedItem="{Binding PatternOverwriteMode, Mode=TwoWay}"
                                  materialAssists:ComboBoxAssist.Label="Pattern overwrite mode"
                                  ToolTip.Tip="Determines how to overwrite the objects in the original beatmap when a pattern gets placed on them." />
                        <ComboBox ItemsSource="{Binding TimingOverwriteModes}"
                                  SelectedItem="{Binding TimingOverwriteMode, Mode=TwoWay}"
                                  materialAssists:ComboBoxAssist.Label="Timing overwrite mode"
                                  ToolTip.Tip="Determines how to combine the timing of the orignal beatmap and the timing of the pattern." />
                        <TextBox materialAssists:TextFieldAssist.Label="Beat divisors"
                                 Text="{Binding BeatDivisors, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource BeatDivisorArrayToStringConverter}}"
                                 ToolTip.Tip="Input any number of beat divisors here separated with commas. Example: 1/4, 1/12, 1/7, 4/5, 0.13435622499" />
                        <TextBox materialAssists:TextFieldAssist.Label="Scale"
                                 Text="{Binding CustomScale, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                 ToolTip.Tip="Scalar to change the size of the pattern." />
                        <TextBox materialAssists:TextFieldAssist.Label="Rotate (degrees)"
                                 Text="{Binding CustomRotate, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                 ToolTip.Tip="Degrees to rotate the pattern clockwise." />

                        <CheckBox Content="Include hitsounds" IsChecked="{Binding IncludeHitsounds}"
                                  ToolTip.Tip="Export the pattern with the hitsound effects of the pattern timing points." />
                        <CheckBox Content="Include kiai" IsChecked="{Binding IncludeKiai}"
                                  ToolTip.Tip="Export the pattern with the kiai of the pattern." />
                        <CheckBox Content="Scale to new circle size" IsChecked="{Binding ScaleToNewCircleSize}"
                                  ToolTip.Tip="Scale the pattern such that the spacing relative to the circle size stays the same." />
                        <CheckBox Content="Scale to new timing" IsChecked="{Binding ScaleToNewTiming}"
                                  ToolTip.Tip="Scale the pattern in time such that the number of beats between objects stays the same in the new timing. Incorrect snaps can occur if your timing has unsnapped redlines. Do not use this if you have 0 or infinite BPM redlines." />
                        <CheckBox Content="Snap to new timing" IsChecked="{Binding SnapToNewTiming}"
                                  ToolTip.Tip="Snap the objects of the pattern to the new timing using the specified beat divisors." />
                        <CheckBox Content="Manualify stacks" IsChecked="{Binding FixStackLeniency}"
                                  ToolTip.Tip="Manually stack objects of the pattern." />
                        <CheckBox Content="Fix global SV" IsChecked="{Binding FixGlobalSv}"
                                  ToolTip.Tip="Adjust greenline SV in the pattern to the new global SV so sliders have the same SV in the new beatmap." />
                        <CheckBox Content="Fix BPM SV" IsChecked="{Binding FixBpmSv}"
                                  ToolTip.Tip="Adjust greenline SV in the pattern to the new BPM so sliders have the same SV in the new beatmap. It is recommended to disable this feature if you are using the 'Scale to new timing' feature." />
                        <CheckBox Content="Fix colourhax" IsChecked="{Binding FixColourHax}"
                                  ToolTip.Tip="Adjust colour skip such that the colour indices of objects stay the same for the pattern and the original beatmap." />
                        <CheckBox Content="Fix slider tick rate" IsChecked="{Binding FixTickRate}"
                                  ToolTip.Tip="Multiply BPM in the pattern so the slider tick rate in the pattern stays the same." />
                        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Opacity="0.75" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Rename" Command="{Binding RenameCollectionCommand}" />
                    <Button Content="Import ZIP" Command="{Binding ImportCollectionCommand}" />
                    <Button Content="Export ZIP" Command="{Binding ExportCollectionCommand}" />
                    <Button Content="Restore" Command="{Binding RestoreCollectionCommand}" />
                </StackPanel>
                <controls:ToolRunButton Grid.Column="1" RunCommand="{Binding RunCommand}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock VerticalAlignment="Bottom" FontWeight="Bold" Opacity="0.58" Text="Made by OliBomby" />
            <controls:ToolProgressBar Grid.Column="1" Height="20" Margin="20,0" Maximum="100" Value="{Binding Progress}" />
        </Grid>
    </Grid>
</UserControl>
