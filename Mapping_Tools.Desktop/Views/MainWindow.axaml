<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mapping_Tools.Desktop.ViewModels"
        xmlns:views="using:Mapping_Tools.Desktop.Views"
        xmlns:materialControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="Mapping_Tools.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1500"
        Height="800"
        MinWidth="500"
        MinHeight="200"
        WindowStartupLocation="Manual"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="35"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource MaterialPaperBrush}"
        Foreground="{DynamicResource MaterialBodyBrush}"
        FontFamily="avares://Mapping_Tools.Desktop/Assets/Fonts#Roboto"
        FontSize="14"
        FontWeight="Medium"
        Title="{Binding Header}"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="AcceptFileDrop"
        DragDrop.Drop="OpenDroppedBeatmaps">

    <Window.Resources>
        <ControlTheme x:Key="ChromeButtonTheme"
                      TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDarkForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource MappingToolsChromeHoverBrush}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource MappingToolsChromePressedBrush}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="ChromeToggleButtonTheme"
                      TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDarkForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource MappingToolsChromeHoverBrush}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource MappingToolsChromePressedBrush}" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:GetStartedViewModel"
                      x:DataType="vm:GetStartedViewModel">
            <views:GetStartedView />
        </DataTemplate>
        <DataTemplate DataType="vm:PreferencesViewModel"
                      x:DataType="vm:PreferencesViewModel">
            <views:PreferencesView />
        </DataTemplate>
        <DataTemplate DataType="vm:RhythmGuideViewModel"
                      x:DataType="vm:RhythmGuideViewModel">
            <views:RhythmGuideView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Menu.top-menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDarkForegroundBrush}" />
            <Setter Property="Height" Value="35" />
        </Style>
        <Style Selector="ToggleButton.navigation-toggle materialIcons|MaterialIcon">
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="ToggleButton.navigation-toggle:checked materialIcons|MaterialIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Menu.top-menu > MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDarkForegroundBrush}" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="ListBox.navigation-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.navigation-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollViewer /template/ :is(ScrollBar):vertical">
            <Setter Property="Width" Value="13" />
            <Setter Property="MinWidth" Value="13" />
            <Setter Property="MaxWidth" Value="13" />
        </Style>
        <Style Selector="ScrollViewer.navigation-scroll /template/ ScrollBar:vertical /template/ Track#PART_Track">
            <Setter Property="Width" Value="10" />
            <Setter Property="RenderTransform" Value="translateX(-3px)" />
        </Style>
        <Style Selector="ScrollViewer.navigation-scroll /template/ ScrollBar:vertical /template/ Thumb#PART_Thumb">
            <Setter Property="Width" Value="10" />
        </Style>
        <Style Selector="TextBox#ToolSearchBox /template/ Panel#PART_TextFieldPanel">
            <Setter Property="MinHeight" Value="35" />
        </Style>
        <Style Selector="TextBox#ToolSearchBox /template/ Border#PART_BackgroundTextField">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBox#ToolSearchBox /template/ Panel#PART_TextContainer">
            <Setter Property="Margin" Value="10,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox#ToolSearchBox /template/ DockPanel#PART_InnerPanel > ContentControl#PART_RightContentControl">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid">
        <Grid RowDefinitions="35,*">
            <materialControls:ColorZone Grid.Row="0"
                                        Height="35"
                                        Padding="0"
                                        Mode="PrimaryMid"
                                        WindowDecorationProperties.ElementRole="TitleBar">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                WindowDecorationProperties.ElementRole="User">
                        <ToggleButton Classes="navigation-toggle"
                                      Theme="{StaticResource ChromeToggleButtonTheme}"
                                      Width="45"
                                      Height="35"
                                      AutomationProperties.Name="Navigation menu"
                                      IsChecked="{Binding IsNavigationOpen, Mode=TwoWay}"
                                      ToolTip.Tip="Use Ctrl+K to open navigation.">
                            <materialIcons:MaterialIcon Kind="Menu"
                                                        Width="28"
                                                        Height="28" />
                        </ToggleButton>

                        <Menu Classes="top-menu">
                            <MenuItem Header="_File"
                                      MinWidth="50"
                                      Height="35">
                                <MenuItem Header="_Open beatmap"
                                          Command="{Binding Workspace.OpenBeatmapCommand}"
                                          ToolTip.Tip="Select the current beatmap with File Explorer.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Folder" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Open current beatmap"
                                          Command="{Binding Workspace.OpenCurrentBeatmapCommand}"
                                          ToolTip.Tip="Set the current beatmap to the selected beatmap in your osu! client.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Restore" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Generate backup"
                                          Command="{Binding Workspace.CreateBackupCommand}"
                                          ToolTip.Tip="Save a backup of the current beatmap to the backups folder.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Backup" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Load backup"
                                          Command="{Binding Workspace.RestoreBackupCommand}"
                                          ToolTip.Tip="Load a backup from the backups folder into the current beatmap.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="BackupRestore" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_QuickUndo"
                                          Command="{Binding Workspace.QuickUndoCommand}"
                                          ToolTip.Tip="Restore the newest retained backup into the beatmap open in osu!.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Undo" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_BetterSave™ current beatmap"
                                          Command="{Binding BetterSaveCommand}"
                                          ToolTip.Tip="Save the beatmap which is currently open in your osu! editor. BetterSave™ saves the beatmap just like the vanilla editor, but decimal values get rounded instead of truncated.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentSave" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator Width="9"
                                       Height="35"
                                       Margin="0"
                                       Foreground="Transparent" />
                            <MenuItem Header="_About"
                                      MinWidth="67"
                                      Height="35">
                                <MenuItem Header="_Open Mapping Tools folder"
                                          Command="{Binding Workspace.OpenApplicationFolderCommand}"
                                          ToolTip.Tip="Open the Mapping Tools folder.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Open backups folder"
                                          Command="{Binding Workspace.OpenBackupsFolderCommand}"
                                          ToolTip.Tip="Open the backups folder.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Check for updates"
                                          IsEnabled="False"
                                          ToolTip.Tip="Check if there are updates available.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Update" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Website"
                                          Command="{Binding OpenWebsiteCommand}"
                                          ToolTip.Tip="Open the official Mapping Tools website in your browser.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="OpenInBrowser" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Github"
                                          Command="{Binding OpenGitHubCommand}"
                                          ToolTip.Tip="Go to the Mapping Tools Github.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Github" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Donate"
                                          Command="{Binding OpenDonateCommand}"
                                          ToolTip.Tip="Support Mapping Tools.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Heart" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_About"
                                          Command="{Binding OpenAboutCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Information" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="_Project"
                                      MinWidth="67"
                                      Height="35"
                                      IsVisible="{Binding HasProjectMenu}">
                                <MenuItem Header="_Save project"
                                          Command="{Binding SaveProjectCommand}"
                                          ToolTip.Tip="Save tool settings to file.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentSave" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Open project"
                                          Command="{Binding OpenProjectCommand}"
                                          ToolTip.Tip="Load tool settings from file.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Folder" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_New project"
                                          Command="{Binding NewProjectCommand}"
                                          ToolTip.Tip="Load the default tool settings.">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="RocketLaunch" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                WindowDecorationProperties.ElementRole="User">
                        <Button Theme="{StaticResource ChromeButtonTheme}"
                                Width="49"
                                Height="35"
                                AutomationProperties.Name="Minimize"
                                Click="MinimizeWindow"
                                ToolTip.Tip="Minimize">
                            <materialIcons:MaterialIcon Kind="WindowMinimize"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Theme="{StaticResource ChromeButtonTheme}"
                                Width="47"
                                Height="35"
                                AutomationProperties.Name="Maximize or restore"
                                Click="ToggleMaximizeWindow"
                                ToolTip.Tip="Maximize or restore">
                            <materialIcons:MaterialIcon x:Name="MaximizeIcon"
                                                        Kind="WindowMaximize"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Theme="{StaticResource ChromeButtonTheme}"
                                Width="49"
                                Height="35"
                                AutomationProperties.Name="Close"
                                Click="CloseWindow"
                                ToolTip.Tip="Close">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="_Exit without saving"
                                              Click="CloseWithoutSaving"
                                              ToolTip.Tip="Exits the program without saving any preferences or tool settings." />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <materialIcons:MaterialIcon Kind="WindowClose"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                    </StackPanel>

                    <materialControls:ColorZone Margin="10,0"
                                                Padding="5"
                                                CornerRadius="2"
                                                Mode="PrimaryDark"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Current maps"
                                                WindowDecorationProperties.ElementRole="User"
                                                materialAssists:ShadowAssist.ShadowDepth="Depth0"
                                                PointerPressed="DragCurrentMaps"
                                                ToolTip.Tip="{Binding Workspace.SelectedMapToolTip}">
                        <materialControls:ColorZone.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Open beatmap"
                                          Command="{Binding Workspace.OpenBeatmapCommand}"
                                          ToolTip.Tip="Select the current beatmap with File Explorer.">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="Folder" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Open current beatmap"
                                          Command="{Binding Workspace.OpenCurrentBeatmapCommand}"
                                          ToolTip.Tip="Set the current beatmap to the selected beatmap in your osu! client.">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="Restore" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Generate backup"
                                          Command="{Binding Workspace.CreateBackupCommand}"
                                          ToolTip.Tip="Save a backup of the current beatmap to the backups folder.">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="Backup" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Load backup"
                                          Command="{Binding Workspace.RestoreBackupCommand}"
                                          ToolTip.Tip="Load a backup from the backups folder into the current beatmap.">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="BackupRestore" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_QuickUndo"
                                          Command="{Binding Workspace.QuickUndoCommand}"
                                          ToolTip.Tip="Restore the newest retained backup into the beatmap open in osu!.">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="Undo" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_BetterSave™ current beatmap"
                                          Command="{Binding BetterSaveCommand}"
                                          ToolTip.Tip="Save the beatmap which is currently open in your osu! editor. BetterSave™ saves the beatmap just like the vanilla editor, but decimal values get rounded instead of truncated.">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentSave" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </materialControls:ColorZone.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None"
                                       FontWeight="Normal"
                                       Text="{Binding Workspace.SelectedMapNames}" />
                            <TextBlock Grid.Column="1"
                                       Margin="2,0,1,0"
                                       Text="{Binding Workspace.SelectedMapCountText}"
                                       TextWrapping="NoWrap"
                                       FontStyle="Italic"
                                       FontWeight="Bold" />
                        </Grid>
                    </materialControls:ColorZone>
                </DockPanel>
            </materialControls:ColorZone>

            <SplitView Grid.Row="1"
                       IsPaneOpen="{Binding IsNavigationOpen}"
                       DisplayMode="Inline"
                       OpenPaneLength="200"
                       CompactPaneLength="0">
                <SplitView.Pane>
                    <DockPanel Width="200"
                               Background="{DynamicResource MaterialPaperBrush}">
                        <TextBox x:Name="ToolSearchBox"
                                 DockPanel.Dock="Top"
                                 Classes="clearButton outline"
                                 Margin="16,16,16,0"
                                 Padding="8"
                                 Height="35"
                                 AutomationProperties.Name="Tool search"
                                 UseFloatingPlaceholder="False"
                                 PlaceholderText="Search"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 KeyDown="HandleSearchKeyDown"
                                 ToolTip.Tip="Search registered features">
                        </TextBox>

                        <ListBox x:Name="ToolList"
                                 Classes="navigation-list"
                                 Width="200"
                                 Margin="0,16"
                                 HorizontalAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Tools menu"
                                 ItemsSource="{Binding VisibleFeatures}"
                                 SelectedItem="{Binding HighlightedFeature, Mode=TwoWay}"
                                 KeyDown="HandleToolListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShellFeatureItemViewModel">
                                    <StackPanel>
                                        <Separator IsVisible="{Binding StartsSection}"
                                                   Height="1"
                                                   Margin="8,10,8,10"
                                                   Background="{DynamicResource MaterialDividerBrush}"
                                                   Focusable="False"
                                                   PointerPressed="IgnoreNavigationDivider" />
                                        <Border Classes="navigation-item"
                                                Height="{Binding NavigationHeight}"
                                                Padding="18,0"
                                                PointerPressed="ActivateNavigationItem"
                                                ToolTip.Tip="{Binding Description}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Favorite"
                                                              IsVisible="{Binding !IsFavorite}"
                                                              Command="{Binding ToggleFavoriteCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="StarOutline" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Unfavorite"
                                                              IsVisible="{Binding IsFavorite}"
                                                              Command="{Binding ToggleFavoriteCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="Star" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource MaterialBodyBrush}"
                                                       Text="{Binding DisplayName}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </SplitView.Pane>

                <Grid Background="{DynamicResource MaterialPaperBrush}">
                    <ScrollViewer Margin="20"
                                  HorizontalScrollBarVisibility="{Binding ContentHorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{Binding ContentVerticalScrollBarVisibility}">
                        <ContentControl Content="{Binding CurrentFeature}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </ScrollViewer>

                    <ItemsControl ItemsSource="{Binding NotificationQueue}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="16"
                                  MaxWidth="620">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShellNotificationViewModel">
                                <Border Margin="0,4"
                                        Padding="16,10"
                                        MinWidth="360"
                                        Background="{DynamicResource MaterialSnackbarBackgroundBrush}"
                                        materialAssists:ShadowAssist.ShadowDepth="Depth2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   Foreground="{DynamicResource MaterialBackgroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="1"
                                                Margin="18,0,0,0"
                                                Command="{Binding DismissCommand}"
                                                Content="DISMISS"
                                                Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                                                Background="Transparent" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </SplitView>
        </Grid>
        <Border x:Name="WindowBorder"
                BorderBrush="{DynamicResource MaterialPrimaryDarkBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />
    </Grid>
</Window>
