<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mapping_Tools.Desktop.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Class="Mapping_Tools.Desktop.Views.SlideratorView"
             x:DataType="vm:SlideratorViewModel"
             x:CompileBindings="True">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:ToolViewHeader Grid.Row="0"
                                 Title="Sliderator"
                                 IsQuickRunSupported="True"
                                 HelpText="Sliderator is a tool meant to make sliders with variable velocity. That means sliders that change speed during the animation. You can also make variable velocity streams with this tool.&#x0a;&#x0a;The UI consists of a slider import section, some options, a position/velocity graph, and a slider preview.&#x0a;&#x0a;To get started, simply import one or more sliders using the 'Import sliders' button. Use any of the three different import methods from the dropdown menu.&#x0a;&#x0a;The most important element is the position/velocity graph. This is where you tell Sliderator what you want your slider animation to look like. You can toggle between position and velocity mode by clicking the accent colored button below.&#x0a;Add, remove, or edit anchors with right click and move stuff by dragging with left click. While dragging, hold Shift for horizontal clipping, hold Ctrl for vertical clipping, and hold Alt to disable snapping.&#x0a;&#x0a;Running Sliderator with a constant velocity will give back the original slider. You can manually choose a lower SV and bigger tumour length to optimise your slider.&#x0a;&#x0a;Check out all the options. The tooltips should help you further." />

        <Grid Grid.Row="1" RowDefinitions="2*,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <controls:GraphControl x:Name="GraphControlElement"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Margin="43,0,0,43"
                                    MinMarkerSpacing="20"
                                    GraphState="{Binding GraphState, Mode=TwoWay}"
                                    HorizontalAxisVisible="{Binding HorizontalAxisVisible}"
                                    VerticalAxisVisible="{Binding VerticalAxisVisible}"
                                    StartPointLockedY="{Binding StartPointLockedY}"
                                    IsEditable="True"
                                    MarkerSnappingHorizontal="True"
                                    MarkerSnappingVertical="True"
                                    MarkerSnappingRangeVertical="0.01"
                                    Stroke="Cyan"
                                    ToolTip.Tip="Edit the position/velocity graph with pointer gestures and the context menu." />

            <Border Grid.Row="1"
                    Grid.Column="2"
                    Padding="10"
                    Background="{DynamicResource MaterialPaperBrush}"
                    ToolTip.Tip="Result preview">
                <controls:ObjectVisualiserControl x:Name="PreviewControl"
                                                  HitObject="{Binding VisibleHitObject}"
                                                  CustomPixelLength="{Binding PreviewPixelLength}"
                                                  Progress="{Binding PreviewProgress}"
                                                  Thickness="50"
                                                  BorderThickness="0.1"
                                                  Fill="DarkSlateGray"
                                                  Stroke="YellowGreen"
                                                  SliderBallStroke="White"
                                                  ToolTip.Tip="Preview the sliderball motion and generated path." />
            </Border>

            <ScrollViewer Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="0"
                          Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding ImportModes}"
                                  SelectedItem="{Binding ImportModeSetting}"
                                  Margin="0,0,5,0"
                                  materialAssists:ComboBoxAssist.Label="Object selection mode"
                                  ToolTip.Tip="Import mode" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding TimeCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 IsVisible="{Binding TimeCodeVisible}"
                                 Margin="5,0,5,2"
                                 Width="100"
                                 materialAssists:TextFieldAssist.Label="Time code"
                                 ToolTip.Tip="Input a time code here. Example time code: 00:56:823 (1,2,1,2) - " />
                        <Button Grid.Column="2"
                                Command="{Binding ImportCommand}"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                ToolTip.Tip="Import sliders into the preview.">
                            Import sliders
                        </Button>
                    </Grid>

                    <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding LoadedHitObjects.Count, StringFormat='Loaded {0} slider(s)'}" />
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,5,0"
                                    Click="MoveLeft"
                                    PointerPressed="NavigationPointerPressed"
                                    ToolTip.Tip="Go to previous slider. Hold Shift for quick run before going to previous slider.">
                                <materialIcons:MaterialIcon Kind="KeyboardArrowLeft" Width="24" Height="24" />
                            </Button>
                            <Button Click="MoveRight"
                                    PointerPressed="NavigationPointerPressed"
                                    ToolTip.Tip="Go to next slider. Hold Shift for quick run before going to next slider.">
                                <materialIcons:MaterialIcon Kind="KeyboardArrowRight" Width="24" Height="24" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0" ColumnDefinitions="*,*,*">
                        <TextBox Grid.Column="0"
                                 Margin="0,0,10,0"
                                 Text="{Binding GraphBeats, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 materialAssists:TextFieldAssist.Label="Beat length"
                                 ToolTip.Tip="Duration of the slider in beats." />
                        <TextBox Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Text="{Binding BeatsPerMinute, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 materialAssists:TextFieldAssist.Label="BPM"
                                 ToolTip.Tip="The BPM at which this slider gets played." />
                        <TextBox Grid.Column="2"
                                 Text="{Binding GlobalSv, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 materialAssists:TextFieldAssist.Label="Global SV"
                                 ToolTip.Tip="The Global Slider Velocity at which this slider gets played." />
                    </Grid>

                    <TextBox Margin="0,20,0,0"
                             Text="{Binding ExportTime, Converter={StaticResource TimeToStringConverter}}"
                             IsReadOnly="True"
                             materialAssists:TextFieldAssist.Label="Time"
                             ToolTip.Tip="The time in the current beatmap to export the sliderated slider to." />
                    <ComboBox Margin="0,10,0,0"
                              ItemsSource="{Binding ExportModes}"
                              SelectedItem="{Binding ExportModeSetting}"
                              materialAssists:ComboBoxAssist.Label="Export mode"
                              ToolTip.Tip="Choose how you want to export sliders." />

                    <RadioButton Content="Export as slider"
                                 Margin="0,10,0,0"
                                 GroupName="exportFormat"
                                 IsChecked="{Binding ExportAsNormal}"
                                 ToolTip.Tip="Exports a normal sliderated slider." />
                    <RadioButton Content="Export as stream"
                                 GroupName="exportFormat"
                                 IsChecked="{Binding ExportAsStream}"
                                 ToolTip.Tip="Exports an accelerating stream. This stream uses the beat snap divisor of the graph to determine the density of notes." />
                    <RadioButton Content="Export as invisible slider"
                                 GroupName="exportFormat"
                                 IsChecked="{Binding ExportAsInvisibleSlider}"
                                 ToolTip.Tip="Makes the slider invisible using a method by JPK314. This will also delegate SV to BPM." />

                    <CheckBox Content="Manually choose new SV"
                              Margin="0,10,0,5"
                              IsChecked="{Binding ManualVelocity}"
                              IsVisible="{Binding ExportAsNormal}"
                              ToolTip.Tip="Allows you to manually choose the SV for the sliderator algorithm and optimise the resulting slider." />
                    <TextBox IsVisible="{Binding ExportAsNormal}"
                             IsEnabled="{Binding ManualVelocity}"
                             Margin="0,0,0,5"
                             Text="{Binding NewVelocity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                             materialAssists:TextFieldAssist.Label="New SV"
                             ToolTip.Tip="The new SV for the sliderated slider. This SV influences the Sliderator algorithm. Use lower SV for less lag." />
                    <TextBox IsVisible="{Binding ExportAsNormal}"
                             Text="{Binding MinDendrite, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                             materialAssists:TextFieldAssist.Label="Minimum tumour length"
                             ToolTip.Tip="Minimum length for tumours which slow down the sliderball in the sliderated slider. Longer tumours result in less lag but a more shaky sliderball." />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Expected segment count: "
                                   ToolTip.Tip="This is the estimated segment count for your result. More segments means more lag, so try to optimise this value." />
                        <TextBlock Text="{Binding ExpectedSegments}"
                                   ToolTip.Tip="This is the estimated segment count for your result. More segments means more lag, so try to optimise this value." />
                    </StackPanel>

                    <CheckBox Content="Delegate SV to BPM"
                              Margin="0,15,0,0"
                              IsChecked="{Binding DelegateToBpm}"
                              IsVisible="{Binding ExportAsNormal}"
                              ToolTip.Tip="Use BPM to determine the velocity of the resulting slider instead of greenline SV. This allows you to use SV higher than 10x." />
                    <CheckBox Content="Remove slider ticks"
                              IsChecked="{Binding RemoveSliderTicks}"
                              IsVisible="{Binding ExportAsNormal}"
                              IsEnabled="{Binding DelegateToBpm}"
                              ToolTip.Tip="Use a NaN greenline to remove slider ticks from the resulting slider." />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,10,0" RowDefinitions="Auto,Auto,Auto">
                <Grid Grid.Row="0" Margin="8,0,8,0" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             MaxWidth="140"
                             MinWidth="100"
                             IsVisible="{Binding ExportAsNormal}"
                             Text="{Binding VelocityLimit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                             materialAssists:TextFieldAssist.Label="SV limit"
                             ToolTip.Tip="Self-imposed SV limit to help you make sure the slope in the graph doesn't become greater than this speed limit. For example use 10x SV limit to match the osu! speed limit." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,5,0" Command="{Binding ScaleCompleteCommand}" ToolTip.Tip="Scale graph to completion.">
                            <materialIcons:MaterialIcon Kind="RelativeScale" Width="24" Height="24" />
                        </Button>
                        <Button Margin="0,0,5,0" Command="{Binding ClearGraphCommand}" ToolTip.Tip="Reset graph.">
                            <materialIcons:MaterialIcon Kind="Rocket" Width="24" Height="24" />
                        </Button>
                        <Button Command="{Binding GraphToggleCommand}" ToolTip.Tip="Toggle graph mode.">
                            <TextBlock Text="{Binding GraphModeText}" FontWeight="Bold" Width="24" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Slider Grid.Row="1"
                        Minimum="1"
                        Maximum="16"
                        Value="{Binding BeatSnapDivisor}"
                        ToolTip.Tip="Beat snap divisor."
                        Margin="0,5,0,0" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,10,5,0">
                    <CheckBox IsChecked="{Binding ShowRedAnchors}"
                              Content="Show red anchors"
                              Margin="0,0,5,0"
                              ToolTip.Tip="Show the positions of red anchors in the graph and preview." />
                    <CheckBox IsChecked="{Binding ShowGraphAnchors}"
                              Content="Show graph anchors"
                              ToolTip.Tip="Show the positions of graph anchors in the preview." />
                </StackPanel>
            </Grid>

            <controls:ToolRunButton Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    RunCommand="{Binding RunCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <TextBlock VerticalAlignment="Bottom" FontWeight="Bold" Opacity="0.58" Text="Made by OliBomby, Karoo, &amp; JPK314" />
            <controls:ToolProgressBar Grid.Column="1"
                                      Height="20"
                                      Margin="20,0"
                                      Maximum="100"
                                      Value="{Binding Progress}" />
        </Grid>
    </Grid>
</UserControl>
