<Window x:Class="Mapping_Tools.Desktop.Views.UpdaterWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:vm="using:Mapping_Tools.Desktop.Updates"
        x:DataType="vm:UpdaterViewModel"
        Title="Mapping Tools - Updater"
        Width="700"
        Height="500"
        CanResize="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/mt_icon.ico"
        Background="{DynamicResource MaterialPaperBrush}"
        Foreground="{DynamicResource MaterialBodyBrush}"
        FontFamily="avares://Mapping_Tools.Desktop/Assets/Fonts#Roboto"
        FontSize="14"
        FontWeight="Medium">
    <Grid Margin="30,10,30,30">
        <Grid IsVisible="{Binding IsReadyPanelVisible}"
              RowDefinitions="Auto,*,Auto"
              ColumnDefinitions="*,200">
            <Grid Grid.Row="0"
                  Grid.ColumnSpan="2"
                  ColumnDefinitions="Auto,*">
                <Image Source="/Assets/mt_logo_256.png"
                       Width="64"
                       Margin="10" />
                <TextBlock Grid.Column="1"
                           Text="A new version of Mapping Tools is ready to be installed!"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <materialControls:Card Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,10,0,0"
                                   Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding ReleaseTitle}"
                                   TextWrapping="Wrap"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ReleaseBody}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </materialControls:Card>

            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <Button Content="Install now"
                        Command="{Binding InstallNowCommand}"
                        Margin="0,0,0,20" />
                <Button Content="Install after closing"
                        Command="{Binding InstallAfterClosingCommand}"
                        Classes="light"
                        Margin="0,0,0,20" />
                <Button Content="Skip this version"
                        Command="{Binding SkipVersionCommand}"
                        Classes="flat"
                        Margin="20,20,20,0" />
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsDownloadPanelVisible}"
              RowDefinitions="*,Auto">
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/MTcog256.gif"
                           Width="128"
                           Height="128"
                           HorizontalAlignment="Center" />
                    <TextBlock FontSize="15"
                               Text="Downloading new update ..."
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDarkForegroundBrush}"
                               FontWeight="Normal" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1"
                  Margin="10,0,10,0">
                <ProgressBar Height="15"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding DownloadProgress}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
