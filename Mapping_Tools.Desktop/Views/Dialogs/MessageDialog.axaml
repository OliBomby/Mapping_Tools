<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Mapping_Tools.Desktop.Controls"
        xmlns:vm="using:Mapping_Tools.Desktop.ViewModels.Dialogs"
        x:Class="Mapping_Tools.Desktop.Views.Dialogs.MessageDialog"
        x:DataType="vm:MessageDialogViewModel"
        Title="{Binding Title}"
        MaxWidth="720"
        SizeToContent="WidthAndHeight"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="35"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialPaperBrush}"
        Foreground="{DynamicResource MaterialBodyBrush}"
        FontFamily="avares://Mapping_Tools.Desktop/Assets/Fonts#Roboto"
        FontSize="14"
        FontWeight="Medium">
    <Window.Styles>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:WindowChrome Grid.Row="0"
                               Title="{Binding Title}" />
        <ScrollViewer Grid.Row="1"
                      MaxHeight="520"
                      Padding="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" Spacing="12">
                <SelectableTextBlock Text="{Binding Message}"
                                     FontSize="14"
                                     TextWrapping="Wrap" />
                <Expander Header="Show Error Details"
                          IsVisible="{Binding HasDetails}">
                    <SelectableTextBlock Text="{Binding Details}"
                                         Padding="8"
                                         Opacity="0.75"
                                         TextWrapping="Wrap" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <ItemsControl x:Name="ActionPanel"
                      Grid.Row="2"
                      Margin="8,0,8,8"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DialogChoiceViewModel">
                    <Button Classes="dialog-action primary"
                            Theme="{StaticResource MaterialFlatButton}"
                            Content="{Binding Label}"
                            Command="{Binding Command}"
                            IsDefault="{Binding IsDefault}"
                            IsCancel="{Binding IsCancel}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>