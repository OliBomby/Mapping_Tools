<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mapping_Tools.Desktop.ViewModels.Dialogs"
        xmlns:graph="clr-namespace:Mapping_Tools.Desktop.Controls.Graph"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        x:Class="Mapping_Tools.Desktop.Views.Dialogs.GraphEditorDialog"
        x:DataType="vm:GraphEditorViewModel"
        x:CompileBindings="True"
        Width="560"
        Height="390"
        MinWidth="420"
        MinHeight="300"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
    <dialogHost:DialogHost Identifier="GraphDialog"
                           CloseOnClickAway="True"
                           OverlayBackground="{DynamicResource MappingToolsDialogOverlayBrush}">
        <Grid RowDefinitions="*,Auto" Margin="10">
            <graph:GraphControl x:Name="GraphControlElement"
                                   GraphState="{Binding GraphState, Mode=TwoWay}"
                                   Margin="32,24,12,30" />
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,12,0,0">
                <Button Classes="dialog-action primary"
                        Theme="{StaticResource MaterialFlatButton}"
                        Content="CANCEL"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        MinWidth="88"
                        MinHeight="36" />
                <Button Classes="dialog-action primary"
                        Theme="{StaticResource MaterialFlatButton}"
                        Content="OK"
                        Command="{Binding AcceptCommand}"
                        IsDefault="True"
                        MinWidth="88"
                        MinHeight="36" />
            </StackPanel>
        </Grid>
    </dialogHost:DialogHost>
</UserControl>
