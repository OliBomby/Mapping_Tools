<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mapping_Tools.Desktop.ViewModels.Dialogs"
        xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        x:Class="Mapping_Tools.Desktop.Views.Dialogs.ValueDialogWindow"
        x:DataType="vm:ValueDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        MinWidth="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Button.dialog-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF0277BD" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_DialogActionBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_DialogActionBorder">
                <Setter Property="Background" Value="#1F0277BD" />
            </Style>
            <Style Selector="^:focus /template/ Border#PART_DialogActionBorder">
                <Setter Property="BorderBrush" Value="#FF0277BD" />
            </Style>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Window.Styles>
    <Grid Width="363"
          MaxWidth="363"
          Margin="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          RowDefinitions="Auto,Auto">
        <TextBox x:Name="ValueTextBox"
                 Margin="16,16,16,0"
                 FontSize="18"
                 FontWeight="Medium"
                 materialAssists:TextFieldAssist.Label="{Binding Prompt}"
                 Text="{Binding Text, Mode=TwoWay}" />
        <StackPanel Grid.Row="1"
                    Margin="16,16,16,16"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Classes="dialog-action"
                    Content="{Binding AcceptLabel}"
                    Command="{Binding AcceptCommand}"
                    IsEnabled="{Binding IsValid}"
                    IsDefault="True" />
            <Button Classes="dialog-action"
                    Content="{Binding CancelLabel}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
