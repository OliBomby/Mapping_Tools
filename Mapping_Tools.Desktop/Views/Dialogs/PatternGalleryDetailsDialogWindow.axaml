<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mapping_Tools.Desktop.Interactions"
        x:Class="Mapping_Tools.Desktop.Views.Dialogs.PatternGalleryDetailsDialogWindow"
        x:DataType="vm:PatternGalleryDetailsViewModel"
        Title="Pattern details"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBox Text="{Binding Name, Mode=TwoWay}"
                         Watermark="Name"
                         ToolTip.Tip="The name shown for this pattern." />
                <TextBlock Text="{Binding CreationTimeText, StringFormat='Creation time: {0}'}" />
                <TextBlock Text="{Binding LastUsedTimeText, StringFormat='Time of last use: {0}'}" />
                <TextBlock Text="{Binding UseCountText, StringFormat='Usage count: {0}'}" />
                <TextBlock Text="{Binding ObjectCountText, StringFormat='Object count: {0}'}" />
                <TextBlock Text="{Binding DurationText, StringFormat='Duration: {0}'}" />
                <TextBlock Text="{Binding BeatLengthText, StringFormat='Beat length: {0}'}" />
                <TextBlock Text="{Binding FileName, StringFormat='File name: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}"
                           Foreground="{DynamicResource MaterialValidationErrorBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="OK" Command="{Binding AcceptCommand}" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>