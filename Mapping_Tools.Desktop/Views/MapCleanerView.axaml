<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mapping_Tools.Desktop.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Mapping_Tools.Desktop.Views.MapCleanerView"
             x:DataType="vm:MapCleanerViewModel">
    <Grid RowDefinitions="*,Auto,Auto">
        <ScrollViewer x:Name="ToolScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid Width="{Binding Viewport.Width, ElementName=ToolScroller}"
                  MinWidth="300"
                  Margin="0,0,0,10">
                <StackPanel>
                    <controls:ToolViewHeader
                        Title="Map Cleaner"
                        IsQuickRunSupported="True"
                        HelpText="Cleans the current map of useless greenlines and provides whole-map cleanup options.&#x0a;&#x0a;Map Cleaner preserves the timing-point influences, rebuilds the timing points cleanly, and resnaps greenlines to the objects that use them." />

                    <CheckBox Margin="0,10,0,0" Content="Analyze samples" IsChecked="{Binding AnalyzeSamples}" />
                    <CheckBox Content="Resnap objects" IsChecked="{Binding ResnapObjects}" />
                    <CheckBox Content="Resnap bookmarks" IsChecked="{Binding ResnapBookmarks}" />
                    <CheckBox Content="Remove hitsounds" IsChecked="{Binding RemoveHitsounds}" />
                    <CheckBox Content="Remove unused samples" IsChecked="{Binding RemoveUnusedSamples}" />
                    <CheckBox Content="Remove muting" IsChecked="{Binding RemoveMuting}" />
                    <CheckBox Content="Mute unclickable hitsounds" IsChecked="{Binding RemoveUnclickableHitsounds}" />

                    <TextBlock Margin="0,20,0,0" FontWeight="Bold" Text="Map info" />
                    <CheckBox Content="Map uses volume changes in sliders" IsChecked="{Binding VolumeSliders}" />
                    <CheckBox Content="Map uses sampleset changes in sliders" IsChecked="{Binding SampleSetSliders}" />
                    <CheckBox Content="Map uses volume changes in spinners" IsChecked="{Binding VolumeSpinners}" />

                    <TextBlock Margin="0,20,0,0" FontWeight="Bold" Text="Signatures" />
                    <TextBox MinWidth="100"
                             Margin="0,4,0,0"
                             HorizontalAlignment="Left"
                             materialAssists:TextFieldAssist.Label="Beat divisors"
                             Text="{Binding BeatDivisors,
                                            Mode=TwoWay,
                                            Converter={StaticResource BeatDivisorArrayToStringConverter}}"
                             ToolTip.Tip="Comma-separated fractions, for example 1/16, 1/12." />
                </StackPanel>

                <StackPanel Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsRunning}"
                            Command="{Binding CancelCommand}"
                            Content="Cancel" />
                    <Button Classes="tool-run-action"
                            Command="{Binding RunCommand}"
                            ToolTip.Tip="Run this tool.">
                        <materialIcons:MaterialIcon Kind="Play" />
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock VerticalAlignment="Bottom"
                       FontWeight="Bold"
                       Opacity="0.58"
                       Text="Made by OliBomby" />
            <controls:ToolProgressBar Grid.Column="1"
                                      Classes="tool-progress"
                                      Height="20"
                                      Margin="20,0"
                                      Maximum="100"
                                      Value="{Binding Progress}" />
        </Grid>

        <StackPanel Grid.Row="2"
                    IsVisible="{Binding HasRun}"
                    ToolTip.Tip="The timeline shows control-point changes. Double-click a line to navigate.">
            <controls:TimelineControl Height="100"
                                      StartTime="0"
                                      EndTime="{Binding EndTime}"
                                      Markers="{Binding Markers}"
                                      NavigateCommand="{Binding NavigateCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
