<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Mapping_Tools.Desktop.Localization"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.MetadataManager.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:adapter="using:Mapping_Tools.Desktop.Tools.ComboColourStudio.ViewModels.Adapters"
             xmlns:materialDesign="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             x:Class="Mapping_Tools.Desktop.Tools.MetadataManager.Views.MetadataManagerView"
             x:DataType="vm:MetadataManagerViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid>
            <Grid RowDefinitions="Auto,*,Auto">
                <controls:ToolViewHeader
                    Title="{loc:Tr MetadataManager_Title}"
                    HelpText="{loc:Tr MetadataManager_Help}" />

                <ScrollViewer Grid.Row="1" Margin="0,0,100,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,0,20,0">
                        <Grid Margin="0,20,0,0" ColumnDefinitions="*,Auto,5,Auto,5,Auto">
                            <TextBox Margin="0,0,5,0"
                                     materialAssists:TextFieldAssist.Label="{loc:Tr MetadataManager_ImportLabel}"
                                     Text="{Binding ImportPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip.Tip="{loc:Tr MetadataManager_ImportTip}" />
                            <Button Grid.Column="1" Classes="flat path-picker" Cursor="Hand"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding UseCurrentImportCommand}"
                                    ToolTip.Tip="{loc:Tr MetadataManager_CurrentBeatmapTip}">
                                <materialIcons:MaterialIcon Width="30" Height="30" Kind="RestoreFromTrash" />
                            </Button>
                            <Button Grid.Column="3" Classes="flat path-picker" Cursor="Hand"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding BrowseImportCommand}"
                                    ToolTip.Tip="{loc:Tr MetadataManager_BrowseTip}">
                                <materialIcons:MaterialIcon Width="30" Height="30" Kind="Folder" />
                            </Button>
                            <Button Grid.Column="5" VerticalAlignment="Bottom"
                                    Command="{Binding ImportCommand}"
                                    ToolTip.Tip="{loc:Tr MetadataManager_ImportButtonTip}"
                                    Content="{loc:Tr MetadataManager_ImportButton}" />
                        </Grid>

                        <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto,5,Auto">
                            <TextBox Margin="0,0,5,0"
                                     materialAssists:TextFieldAssist.Label="{loc:Tr MetadataManager_ExportLabel}"
                                     Text="{Binding ExportPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip.Tip="{loc:Tr MetadataManager_ExportTip}" />
                            <TextBlock Grid.Column="1" Margin="3,15,2,0" Padding="0 0 3 0" FontStyle="Italic"
                                       ToolTip.Tip="{loc:Tr MetadataManager_ExportPathsTip}"
                                       Text="{Binding ExportMapCountText}" />
                            <Button Grid.Column="2" Classes="flat path-picker" Cursor="Hand"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding UseCurrentExportCommand}"
                                    ToolTip.Tip="{loc:Tr MetadataManager_CurrentBeatmapTip}">
                                <materialIcons:MaterialIcon Width="30" Height="30" Kind="RestoreFromTrash" />
                            </Button>
                            <Button Grid.Column="4" Classes="flat path-picker" Cursor="Hand"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding BrowseExportCommand}"
                                    ToolTip.Tip="{loc:Tr MetadataManager_BrowseTip}">
                                <materialIcons:MaterialIcon Width="30" Height="30" Kind="Folder" />
                            </Button>
                        </Grid>

                        <Separator Margin="0,10" />

                        <Grid ColumnDefinitions="Auto,10,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_Artist}" />
                            <TextBlock Grid.Column="0" Grid.Row="1" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_RomanisedArtist}" />
                            <TextBlock Grid.Column="0" Grid.Row="2" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_TitleField}" />
                            <TextBlock Grid.Column="0" Grid.Row="3" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_RomanisedTitle}" />
                            <TextBlock Grid.Column="0" Grid.Row="4" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_Creator}" />
                            <TextBlock Grid.Column="0" Grid.Row="5" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_Source}" />
                            <TextBlock Grid.Column="0" Grid.Row="6" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{loc:Tr MetadataManager_Tags}" />
                            <TextBlock Grid.Column="0" Grid.Row="7" Margin="0,50,0,0" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="{loc:Tr MetadataManager_PreviewTime}" />
                            <TextBlock Grid.Column="0" Grid.Row="8" Margin="0,10,0,0" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Text="{loc:Tr MetadataManager_Colours}" />

                            <TextBox Grid.Column="2" Grid.Row="0" Classes="compact"
                                     Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Grid.Row="1" Classes="compact"
                                     Text="{Binding RomanisedArtist, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Grid.Row="2" Classes="compact"
                                     Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Grid.Row="3" Classes="compact"
                                     Text="{Binding RomanisedTitle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Grid.Row="4" Classes="compact"
                                     Text="{Binding BeatmapCreator, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Grid.Row="5" Classes="compact"
                                     Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Grid.Row="6" Classes="compact multiline" TextWrapping="Wrap"
                                     Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <CheckBox Grid.Column="2" Grid.Row="7" VerticalAlignment="Top"
                                       Content="{loc:Tr MetadataManager_RemoveDuplicateTags}"
                                      IsChecked="{Binding DoRemoveDuplicateTags}" />
                            <CheckBox Grid.Column="2" Grid.Row="7" Margin="0,24,0,0" VerticalAlignment="Top"
                                       Content="{loc:Tr MetadataManager_ResetIds}"
                                      IsChecked="{Binding ResetIds}"
                                       ToolTip.Tip="{loc:Tr MetadataManager_ResetIdsTip}" />
                            <TextBox Grid.Column="2" Grid.Row="7" Classes="compact" Margin="0,50,0,0"
                                     TextWrapping="Wrap"
                                     Text="{Binding PreviewTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource TimeToStringConverter}, ConverterParameter=-1}" />

                            <StackPanel Grid.Column="2" Grid.Row="8">
                                <ToggleSwitch HorizontalAlignment="Left" Margin="5,10,0,10"
                                              IsChecked="{Binding UseComboColours}"
                                               ToolTip.Tip="{loc:Tr MetadataManager_ComboColoursTip}" />
                                <StackPanel IsEnabled="{Binding UseComboColours}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:Card>
                                            <ListBox ItemsSource="{Binding ComboColours}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="adapter:ObservableComboColour">
                                                        <ColorPicker
                                                            Color="{Binding Color, Mode=TwoWay, Converter={StaticResource RgbaColourToAvaloniaColorConverter}}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </materialDesign:Card>
                                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                                       VerticalAlignment="Bottom"
                                                                       Command="{Binding AddComboColourCommand}"
                                                                        ToolTip.Tip="{loc:Tr MetadataManager_AddComboColourTip}">
                                            <materialIcons:MaterialIcon Width="24" Height="24" Kind="Plus" />
                                        </materialDesign:FloatingButton>
                                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                                       VerticalAlignment="Bottom"
                                                                       Command="{Binding RemoveComboColourCommand}"
                                                                        ToolTip.Tip="{loc:Tr MetadataManager_RemoveComboColourTip}">
                                            <materialIcons:MaterialIcon Width="24" Height="24" Kind="Minus" />
                                        </materialDesign:FloatingButton>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <materialDesign:Card>
                                            <ListBox ItemsSource="{Binding SpecialColours}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="adapter:ObservableSpecialColour">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox Classes="compact" Width="202" Margin="0,0,10,0"
                                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                      ToolTip.Tip="{loc:Tr MetadataManager_SpecialColourNameTip}" />
                                                            <ColorPicker
                                                                Color="{Binding Color, Mode=TwoWay, Converter={StaticResource RgbaColourToAvaloniaColorConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </materialDesign:Card>
                                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                                       VerticalAlignment="Bottom"
                                                                       Command="{Binding AddSpecialColourCommand}"
                                                                        ToolTip.Tip="{loc:Tr MetadataManager_AddSpecialColourTip}">
                                            <materialIcons:MaterialIcon Width="24" Height="24" Kind="Plus" />
                                        </materialDesign:FloatingButton>
                                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                                       VerticalAlignment="Bottom"
                                                                       Command="{Binding RemoveSpecialColourCommand}"
                                                                        ToolTip.Tip="{loc:Tr MetadataManager_RemoveSpecialColourTip}">
                                            <materialIcons:MaterialIcon Width="24" Height="24" Kind="Minus" />
                                        </materialDesign:FloatingButton>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="10" Foreground="{DynamicResource MaterialValidationErrorBrush}"
                               Text="{loc:Tr MetadataManager_FileNameOverflow}"
                               IsVisible="{Binding IsBeatmapFileNameOverflowVisible}" />
                    <TextBlock Margin="10" Foreground="{DynamicResource MaterialValidationErrorBrush}"
                               Text="{loc:Tr MetadataManager_TagsOverflow}"
                               IsVisible="{Binding IsTagsOverflowVisible}" />
                </StackPanel>

            </Grid>
            <controls:ToolRunButton Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    RunCommand="{Binding RunCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0">
                <WrapPanel VerticalAlignment="Bottom">
                    <TextBlock TextWrapping="NoWrap" FontWeight="Bold" Opacity="0.58"
                               Text="{loc:Tr MetadataManager_MadeBy}" />
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="1">
                <controls:ToolProgressBar Height="20" Margin="20,0,20,0"
                                          Background="{x:Null}" BorderBrush="{x:Null}"
                                          Maximum="100" Value="{Binding Progress}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
