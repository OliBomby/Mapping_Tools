<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.ComboColourStudio.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:adapter="using:Mapping_Tools.Desktop.Tools.ComboColourStudio.ViewModels.Adapters"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialDesign="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Mapping_Tools.Desktop.Tools.ComboColourStudio.Views.ComboColourStudioView"
             x:Name="Root"
             x:DataType="vm:ComboColourStudioViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto">
            <controls:ToolViewHeader
                Title="Combo Colour Studio"
                IsQuickRunSupported="True"
                HelpText="With Combo Colour Studio you can easily customize the combo colours of your beatmap. AKA colour haxing.&#x0a;&#x0a;You define colored sections much like how you use timing points in the osu! editor. Just add a new colour point and define the sequence of combo colours.&#x0a;&#x0a;You can also define 'burst' colour points which only work for one combo, so you can emphasize specific patterns using colour.&#x0a;&#x0a;You can get started by adding a combo colour using the plus on the bottom left or by importing combo colours from an existing map. The combo colours can be edited by clicking on the coloured circles.&#x0a;&#x0a;Add a colour point by clicking on the plus on the bottom right. You can edit the colour sequence by double clicking the colour sequence cell." />

            <Grid Grid.Row="1" RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0" ItemsSource="{Binding ColourPoints}"
                          SelectedItem="{Binding SelectedColourPoint, Mode=TwoWay}"
                          SelectionChanged="ColourPointsSelectionChanged"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          SelectionMode="Extended" IsReadOnly="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow" />
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Offset"
                                            Binding="{Binding Time, Mode=TwoWay, Converter={StaticResource TimeToStringConverter}}" />
                        <DataGridTemplateColumn Header="Mode">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="adapter:ObservableColourPoint">
                                    <TextBlock Text="{Binding Mode}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="adapter:ObservableColourPoint">
                                    <ComboBox ItemsSource="{Binding ColourPointModes}"
                                              SelectedItem="{Binding Mode, Mode=TwoWay}" Classes="compact" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Colour Sequence">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="adapter:ObservableColourPoint">
                                    <ItemsControl ItemsSource="{Binding ColourSequence}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="adapter:ObservableSpecialColour">
                                                <Border Width="24" Height="24" CornerRadius="12" Margin="2"
                                                        Background="{Binding Color, Converter={StaticResource RgbaColourToAvaloniaBrushConverter}}"
                                                        ToolTip.Tip="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="adapter:ObservableColourPoint">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding DataContext.ComboColours, ElementName=Root}"
                                                  SelectedItem="{Binding DataContext.SelectedSequenceColour, ElementName=Root, Mode=TwoWay}"
                                                  Classes="compact" />
                                        <ListBox ItemsSource="{Binding ColourSequence}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="adapter:ObservableSpecialColour">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <Border Width="28" Height="28" CornerRadius="14"
                                                                Background="{Binding Color, Converter={StaticResource RgbaColourToAvaloniaBrushConverter}}"
                                                                VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                                                   Text="{Binding Name}" />
                                                        <Button Grid.Column="2" Classes="flat" Tag="{Binding}"
                                                                Click="RemoveSequenceColour_OnClick" ToolTip.Tip="Remove this colour.">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5,0"
                                                                        Command="{Binding DataContext.AddSequenceColourCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="Add the selected colour to this sequence.">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="22" Height="22" />
                                        </materialDesign:FloatingButton>
                                        <materialDesign:FloatingButton Classes="mini light no-transitions"
                                                                        Command="{Binding DataContext.RemoveSequenceColourCommand, ElementName=Root}"
                                                                        ToolTip.Tip="Remove the last colour from this sequence.">
                                            <materialIcons:MaterialIcon Kind="Minus" Width="22" Height="22" />
                                        </materialDesign:FloatingButton>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Orientation="Horizontal">
                            <materialDesign:Card>
                            <ListBox ItemsSource="{Binding ComboColours}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="adapter:ObservableSpecialColour">
                                        <ColorPicker
                                            Color="{Binding Color, Mode=TwoWay, Converter={StaticResource RgbaColourToAvaloniaColorConverter}}"
                                            ToolTip.Tip="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </materialDesign:Card>
                            <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="10,5,5,5"
                                                           Command="{Binding AddComboColourCommand}"
                                                           ToolTip.Tip="Add a new combo colour.">
                                <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" />
                            </materialDesign:FloatingButton>
                            <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                           Command="{Binding RemoveComboColourCommand}"
                                                           ToolTip.Tip="Remove the last combo colour.">
                                <materialIcons:MaterialIcon Kind="Minus" Width="24" Height="24" />
                            </materialDesign:FloatingButton>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                           x:Name="AddColourPointButton"
                                                           Click="AddColourPointButtonClick"
                                                           ToolTip.Tip="Add a new colour point.">
                                <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24" />
                            </materialDesign:FloatingButton>
                            <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="5"
                                                           Command="{Binding RemoveColourPointCommand}"
                                                           ToolTip.Tip="Remove selected colour points or the last point.">
                                <materialIcons:MaterialIcon Kind="Minus" Width="24" Height="24" />
                            </materialDesign:FloatingButton>
                        </StackPanel>
                    </Grid>

                    <materialDesign:Card Grid.Row="1" Padding="2" Margin="0,10,5,5"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,Auto,120">
                                <Button Content="Import colours" Margin="5,0"
                                        Command="{Binding ImportColoursCommand}"
                                        ToolTip.Tip="Import combo colours from a beatmap." />
                                <Button Grid.Column="1" Content="Import colourhax" Margin="5,0,20,0"
                                        Command="{Binding ImportColourHaxCommand}"
                                        ToolTip.Tip="Import colour haxing from a beatmap and populate colour points." />
                                <TextBox Grid.Column="2" Width="120" Margin="10,0,10,5"
                                         materialAssists:TextFieldAssist.Label="Max burst length"
                                         Text="{Binding Project.MaxBurstLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantInt32Converter}}"
                                         ToolTip.Tip="Determines the maximum combo size for burst combos. Combos longer than this value can't get a colour from burst colour points." />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBox materialAssists:TextFieldAssist.Label="Import from beatmap"
                                         Text="{Binding ImportPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="1" Classes="flat" Margin="8,0,0,0"
                                        Command="{Binding UseCurrentImportCommand}"
                                        ToolTip.Tip="Use the beatmap currently open in osu!.">
                                    <materialIcons:MaterialIcon Kind="RestoreFromTrash" Width="24" Height="24" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <controls:ToolRunButton Grid.Column="1" Margin="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        RunCommand="{Binding RunCommand}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0">
                <WrapPanel VerticalAlignment="Bottom">
                    <TextBlock TextWrapping="NoWrap" FontWeight="Bold" Opacity="0.58"
                               Text="Made by OliBomby" />
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="1">
                <controls:ToolProgressBar Height="20" Margin="20,0,20,0" Maximum="100"
                                          Value="{Binding Progress}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
