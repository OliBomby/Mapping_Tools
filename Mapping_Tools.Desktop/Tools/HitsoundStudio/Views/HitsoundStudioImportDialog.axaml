<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hitsoundStudio="clr-namespace:Mapping_Tools.Desktop.Tools.HitsoundStudio.Interactions"
        xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        x:Class="Mapping_Tools.Desktop.Tools.HitsoundStudio.Views.HitsoundStudioImportDialog"
        x:DataType="hitsoundStudio:HitsoundStudioImportDialogViewModel"
        Width="620" Height="650"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
        <TextBlock FontSize="24" FontWeight="Bold" Text="Import Hitsound Layer" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
                <TextBox Text="{Binding Name, Mode=TwoWay}" materialAssists:TextFieldAssist.Label="Name"
                         ToolTip.Tip="The convenient name shown in the layer list." />
                <ComboBox ItemsSource="{Binding ImportTypes}" SelectedItem="{Binding ImportType, Mode=TwoWay}"
                          materialAssists:ComboBoxAssist.Label="Import type"
                          ToolTip.Tip="Choose a simple layer, stack, hitsound, MIDI, or storyboard import." />
                <ComboBox IsVisible="{Binding IsSimpleOrStackImport}" ItemsSource="{Binding SampleSets}"
                          SelectedItem="{Binding SampleSet, Mode=TwoWay}"
                          materialAssists:ComboBoxAssist.Label="Sample set"
                          ToolTip.Tip="Sample set used by a simple or stack layer." />
                <ComboBox IsVisible="{Binding IsSimpleOrStackImport}" ItemsSource="{Binding Hitsounds}"
                          SelectedItem="{Binding Hitsound, Mode=TwoWay}"
                          materialAssists:ComboBoxAssist.Label="Hitsound"
                          ToolTip.Tip="Hitsound used by a simple or stack layer." />
                <Grid IsVisible="{Binding IsSimpleOrStackImport}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding SamplePath, Mode=TwoWay}" materialAssists:TextFieldAssist.Label="Hitsound sample or SoundFont"
                             ToolTip.Tip="Audio file or SoundFont used by a simple layer or SoundFont note." />
                    <Button Grid.Column="1" Content="…" Command="{Binding PickSampleCommand}"
                            ToolTip.Tip="Choose a sample or SoundFont." />
                </Grid>
                <Grid IsVisible="{Binding HasImportSource}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding SourcePaths, Mode=TwoWay}" AcceptsReturn="True" Height="90"
                             materialAssists:TextFieldAssist.Label="Source path(s)"
                             ToolTip.Tip="Beatmap, MIDI, or storyboard source paths. Multiple paths are supported for hitsound/storyboard imports." />
                    <Button Grid.Column="1" Content="…" Command="{Binding PickSourceCommand}"
                            ToolTip.Tip="Choose one or more import sources." />
                </Grid>
                <Grid IsVisible="{Binding IsStackImport}" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <TextBox Text="{Binding XText, Mode=TwoWay}" materialAssists:TextFieldAssist.Label="X coordinate (-1 = any)" />
                    <TextBox Grid.Column="1" Text="{Binding YText, Mode=TwoWay}" materialAssists:TextFieldAssist.Label="Y coordinate (-1 = any)" />
                </Grid>
                <TextBox IsVisible="{Binding IsMidiImport}" Text="{Binding OffsetText, Mode=TwoWay}"
                         materialAssists:TextFieldAssist.Label="MIDI offset (ms)" />
                <Grid IsVisible="{Binding IsMidiImport}" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <TextBox IsVisible="{Binding IsLengthSettingsVisible}"
                             Text="{Binding LengthRoughnessText, Mode=TwoWay}" materialAssists:TextFieldAssist.Label="Length rounding roughness" />
                    <TextBox Grid.Column="1" IsVisible="{Binding IsVelocitySettingsVisible}"
                             Text="{Binding VelocityRoughnessText, Mode=TwoWay}"
                             materialAssists:TextFieldAssist.Label="Velocity rounding roughness" />
                </Grid>
                <CheckBox IsVisible="{Binding IsSampleImport}" Content="Discriminate volumes"
                          IsChecked="{Binding DiscriminateVolumes, Mode=TwoWay}"
                          ToolTip.Tip="Keep source volume differences as separate layers." />
                <CheckBox IsVisible="{Binding IsHitsoundsImport}" Content="Detect duplicate samples"
                          IsChecked="{Binding DetectDuplicateSamples, Mode=TwoWay}"
                          ToolTip.Tip="Canonicalize identical audio files in the source mapset." />
                <CheckBox IsVisible="{Binding IsSampleImport}" Content="Remove duplicate events"
                          IsChecked="{Binding RemoveDuplicates, Mode=TwoWay}"
                          ToolTip.Tip="Remove repeated events at the same millisecond." />
                <CheckBox IsVisible="{Binding IsHitsoundsImport}" Content="Include storyboard sounds"
                          IsChecked="{Binding IncludeStoryboard, Mode=TwoWay}"
                          ToolTip.Tip="Include storyboard samples during hitsound import." />
                <CheckBox IsVisible="{Binding IsMidiImport}" Content="Discriminate MIDI instruments"
                          IsChecked="{Binding DiscriminateInstruments, Mode=TwoWay}" />
                <CheckBox IsVisible="{Binding IsMidiImport}" Content="Discriminate MIDI keys"
                          IsChecked="{Binding DiscriminateKeys, Mode=TwoWay}" />
                <CheckBox IsVisible="{Binding IsMidiImport}" Content="Discriminate MIDI lengths"
                          IsChecked="{Binding DiscriminateLengths, Mode=TwoWay}" />
                <CheckBox IsVisible="{Binding IsMidiImport}" Content="Discriminate MIDI velocities"
                          IsChecked="{Binding DiscriminateVelocities, Mode=TwoWay}" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Foreground="OrangeRed" Text="{Binding Error}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
            <Button Classes="dialog-action dark"
                    Content="Accept"
                    Command="{Binding AcceptCommand}"
                    MinWidth="88"
                    MinHeight="36"
                    IsDefault="True" />
            <Button Classes="dialog-action dark"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="88"
                    MinHeight="36" />
        </StackPanel>
    </Grid>
</UserControl>
