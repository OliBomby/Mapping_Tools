<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Mapping_Tools.Desktop.Localization"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.RhythmGuide.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:converters="using:Mapping_Tools.Desktop.Converters"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Mapping_Tools.Desktop.Tools.RhythmGuide.Views.RhythmGuideView"
             x:DataType="vm:RhythmGuideViewModel">
    <UserControl.Resources>
        <converters:StringArrayToStringConverter x:Key="StringArrayToStringConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto">
        <Grid>
            <StackPanel Margin="0,0,120,0">
                <controls:ToolViewHeader
                    Title="{loc:Tr RhythmGuide_Title}"
                    HelpText="{loc:Tr RhythmGuide_Help}" />

                <Grid Margin="0,20,0,0" ColumnDefinitions="*,Auto,Auto,5,Auto">
                    <TextBox materialAssists:TextFieldAssist.Label="{loc:Tr RhythmGuide_CopyFrom}"
                             Text="{ReflectionBinding SourcePaths, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource StringArrayToStringConverter}}"
                             ToolTip.Tip="{loc:Tr RhythmGuide_SourceTip}" />
                    <TextBlock Grid.Column="1" Margin="3,15,2,0" Padding="0 0 3 0" FontStyle="Italic"
                               ToolTip.Tip="{loc:Tr RhythmGuide_PathListTip}"
                               Text="{Binding SourceCountText}" />
                    <Button Grid.Column="2" Classes="flat path-picker" Cursor="Hand" VerticalAlignment="Bottom"
                            Command="{Binding UseCurrentSourceCommand}"
                            ToolTip.Tip="{loc:Tr MetadataManager_CurrentBeatmapTip}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="RestoreFromTrash" />
                    </Button>
                    <Button Grid.Column="4" Classes="flat path-picker" Cursor="Hand" VerticalAlignment="Bottom"
                            Command="{Binding BrowseSourcesCommand}"
                            ToolTip.Tip="{loc:Tr MetadataManager_BrowseTip}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="Folder" />
                    </Button>
                </Grid>

                <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto,5,Auto">
                    <TextBox Margin="0,0,5,0" materialAssists:TextFieldAssist.Label="{loc:Tr RhythmGuide_CopyTo}"
                             Text="{Binding ExportPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="{loc:Tr RhythmGuide_DestinationTip}" />
                    <Button Grid.Column="1" Classes="flat path-picker" Cursor="Hand" VerticalAlignment="Bottom"
                            Command="{Binding UseCurrentExportCommand}"
                            ToolTip.Tip="{loc:Tr MetadataManager_CurrentBeatmapTip}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="RestoreFromTrash" />
                    </Button>
                    <Button Grid.Column="3" Classes="flat path-picker" Cursor="Hand" VerticalAlignment="Bottom"
                            Command="{Binding BrowseExportCommand}"
                            ToolTip.Tip="{loc:Tr MetadataManager_BrowseTip}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="Folder" />
                    </Button>
                </Grid>

                <ComboBox Width="300" Margin="0,10,0,0" HorizontalAlignment="Left"
                          ItemsSource="{Binding ExportModes}" SelectedItem="{Binding ExportMode}"
                          materialAssists:ComboBoxAssist.Label="{loc:Tr RhythmGuide_ExportMode}"
                          ToolTip.Tip="{loc:Tr RhythmGuide_ExportModeTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:TranslatedBinding Converter={x:Static loc:ToolChoiceConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Width="300" Margin="0,10,0,0" HorizontalAlignment="Left"
                          ItemsSource="{Binding OutputGameModes}" SelectedItem="{Binding OutputGameMode}"
                          materialAssists:ComboBoxAssist.Label="{loc:Tr RhythmGuide_GameMode}"
                          ToolTip.Tip="{loc:Tr RhythmGuide_GameModeTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:TranslatedBinding Converter={x:Static loc:ToolChoiceConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Width="300" Margin="0,10,0,0" HorizontalAlignment="Left"
                         materialAssists:TextFieldAssist.Label="{loc:Tr RhythmGuide_DifficultyName}"
                         Text="{Binding OutputName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip.Tip="{loc:Tr RhythmGuide_DifficultyNameTip}" />
                <CheckBox Margin="0,30,0,0" Content="{loc:Tr RhythmGuide_NcEverything}" IsChecked="{Binding NcEverything}" />
                <ComboBox Width="300" Margin="0,10,0,0" HorizontalAlignment="Left"
                          ItemsSource="{Binding SelectionModes}" SelectedItem="{Binding SelectionMode}"
                          materialAssists:ComboBoxAssist.Label="{loc:Tr RhythmGuide_SelectionMode}"
                          ToolTip.Tip="{loc:Tr RhythmGuide_SelectionModeTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:TranslatedBinding Converter={x:Static loc:ToolChoiceConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <controls:ToolRunButton Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    RunCommand="{Binding RunCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0">
                <WrapPanel VerticalAlignment="Bottom">
                    <TextBlock TextWrapping="NoWrap" FontWeight="Bold" Opacity="0.58"
                               Text="{loc:Tr Common_MadeByOliBomby}" />
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="1">
                <controls:ToolProgressBar Height="20" Margin="20,0,20,0"
                                          Background="{x:Null}" BorderBrush="{x:Null}"
                                          Maximum="100" Value="{Binding Progress}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
