<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mapping_Tools.Desktop.Tools.GeometryDashboard.Controls.GeometryHotkeyEditor">
    <TextBox x:Name="Editor" IsReadOnly="True" TextAlignment="Center"
             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
             ContextFlyout="{x:Null}" KeyDown="EditorKeyDown" />
</UserControl>
