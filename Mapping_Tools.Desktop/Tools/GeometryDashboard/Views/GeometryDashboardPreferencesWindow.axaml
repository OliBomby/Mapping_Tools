<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Mapping_Tools.Desktop.Controls"
        xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:geometryDashboard="clr-namespace:Mapping_Tools.Desktop.Tools.GeometryDashboard.Interactions"
        x:Class="Mapping_Tools.Desktop.Tools.GeometryDashboard.Views.GeometryDashboardPreferencesWindow"
        x:DataType="geometryDashboard:GeometryDashboardPreferencesDialogViewModel"
        Title="Geometry Dashboard Preferences" Height="500" Width="570" MinWidth="575" MinHeight="360"
        CanResize="True" WindowStartupLocation="CenterOwner" WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="35"
        FontSize="14"
        Background="{DynamicResource MaterialPaperBrush}" Foreground="{DynamicResource MaterialBodyBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:WindowChrome Grid.Row="0"
                               Title="Preferences" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Hidden">
            <Border Padding="10">
                <StackPanel>
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </StackPanel.Styles>
                    <Border Padding="5,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Snap key" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           ToolTip.Tip="Press and hold this key to snap your cursor to the closest virtual object." />
                                <controls:HotkeyEditor Width="150" VerticalAlignment="Bottom"
                                                       Classes="compact"
                                                       Hotkey="{Binding Preferences.SnapHotkey, Mode=TwoWay}"
                                                       ToolTip.Tip="Press and hold this key to snap your cursor to the closest virtual object." />
                                <TextBlock Width="100" Text="Select key" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                           ToolTip.Tip="Press or hold this key to select virtual objects." />
                                <controls:HotkeyEditor Width="150" VerticalAlignment="Bottom"
                                                       Classes="compact"
                                                       Hotkey="{Binding Preferences.SelectHotkey, Mode=TwoWay}"
                                                       ToolTip.Tip="Press or hold this key to select virtual objects." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Lock key" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           ToolTip.Tip="Press or hold this key to lock virtual objects." />
                                <controls:HotkeyEditor Width="150" VerticalAlignment="Bottom"
                                                       Classes="compact"
                                                       Hotkey="{Binding Preferences.LockHotkey, Mode=TwoWay}"
                                                       ToolTip.Tip="Press or hold this key to lock virtual objects." />
                                <TextBlock Width="100" Text="Usability key" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                           ToolTip.Tip="Press or hold this key to select which virtual objects can get used by generators." />
                                <controls:HotkeyEditor Width="150" VerticalAlignment="Bottom"
                                                       Classes="compact"
                                                       Hotkey="{Binding Preferences.InheritHotkey, Mode=TwoWay}"
                                                       ToolTip.Tip="Press or hold this key to select which virtual objects can get used by generators." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Refresh key" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           ToolTip.Tip="Press and hold this key to continuously refresh the hit objects in the root layer of the object tree." />
                                <controls:HotkeyEditor Width="150" VerticalAlignment="Bottom"
                                                       Classes="compact"
                                                       Hotkey="{Binding Preferences.RefreshHotkey, Mode=TwoWay}"
                                                       ToolTip.Tip="Press and hold this key to continuously refresh the hit objects in the root layer of the object tree." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Offset" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           ToolTip.Tip="Offsets the overlay box. Use these fields when the automatic editor-to-screen coordinate conversion seems to fail." />
                                <TextBox Width="95" VerticalAlignment="Bottom" Margin="0,0,10,0"
                                         materialAssists:TextFieldAssist.Label="Left offset"
                                         Text="{Binding Preferences.OffsetLeft, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                         ToolTip.Tip="Offset the left side of the overlay in osu! pixels." />
                                <TextBox Width="95" VerticalAlignment="Bottom" Margin="0,0,10,0"
                                         materialAssists:TextFieldAssist.Label="Top offset"
                                         Text="{Binding Preferences.OffsetTop, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                         ToolTip.Tip="Offset the top side of the overlay in osu! pixels." />
                                <TextBox Width="95" VerticalAlignment="Bottom" Margin="0,0,10,0"
                                         materialAssists:TextFieldAssist.Label="Right offset"
                                         Text="{Binding Preferences.OffsetRight, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                         ToolTip.Tip="Offset the right side of the overlay in osu! pixels." />
                                <TextBox Width="95" VerticalAlignment="Bottom"
                                         materialAssists:TextFieldAssist.Label="Bottom offset"
                                         Text="{Binding Preferences.OffsetBottom, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                         ToolTip.Tip="Offset the bottom side of the overlay in osu! pixels." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Complexity" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           ToolTip.Tip="Specifies how many layers of virtual objects can be used. More layers means more recursion of generating virtual objects." />
                                <TextBox Width="120" VerticalAlignment="Bottom"
                                         materialAssists:TextFieldAssist.Label="Inception level"
                                         Text="{Binding Preferences.InceptionLevel, Mode=TwoWay, Converter={StaticResource InvariantInt32Converter}}"
                                         ToolTip.Tip="Specifies how many layers of virtual objects can be used. More layers means more recursion of generating virtual objects. It is recommended to use between 2 and 10 layers." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Downkey" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Customize what gets displayed while the Snap Key is pressed." />
                                <ListBox Classes="material-tool-toggle-list" SelectionMode="Multiple,Toggle"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem IsSelected="{Binding KeyDownEverything, Mode=TwoWay}"
                                                 ToolTip.Tip="Everything">
                                        <materialIcons:MaterialIcon Kind="AllInclusive" Width="20" Height="20" />
                                    </ListBoxItem>
                                    <ListBoxItem Content="P" IsSelected="{Binding KeyDownParents, Mode=TwoWay}"
                                                 ToolTip.Tip="Parents and parents of parents" />
                                    <ListBoxItem Content="DP" IsSelected="{Binding KeyDownDirectParents, Mode=TwoWay}"
                                                 ToolTip.Tip="Direct parents" />
                                    <ListBoxItem Content="C" IsSelected="{Binding KeyDownChildren, Mode=TwoWay}"
                                                 ToolTip.Tip="Children and children of children" />
                                    <ListBoxItem Content="DC" IsSelected="{Binding KeyDownDirectChildren, Mode=TwoWay}"
                                                 ToolTip.Tip="Direct children" />
                                </ListBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Upkey" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Customize what gets displayed while the Snap Key is not pressed." />
                                <StackPanel>
                                    <RadioButton Content="Everything" GroupName="KeyUpView"
                                                 IsChecked="{Binding KeyUpEverything, Mode=TwoWay}"
                                                 ToolTip.Tip="Default behavior. Display all virtual objects even if the Activation Key is not pressed." />
                                    <RadioButton Content="Nothing" GroupName="KeyUpView"
                                                 IsChecked="{Binding KeyUpNothing, Mode=TwoWay}"
                                                 ToolTip.Tip="Do not display anything if the Activation Key is not pressed." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Selection" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Customize which hit objects get used for generating virtual objects." />
                                <StackPanel>
                                    <RadioButton Content="All visible" GroupName="SelectedObjects"
                                                 IsChecked="{Binding SelectedAllVisible, Mode=TwoWay}"
                                                 ToolTip.Tip="Use the visible hit objects regardless of selection." />
                                    <RadioButton Content="Visible or selected" GroupName="SelectedObjects"
                                                 IsChecked="{Binding SelectedVisibleOrSelected, Mode=TwoWay}"
                                                 ToolTip.Tip="Use the visible hit objects, or use the selected hit objects if there are any selected." />
                                    <RadioButton Content="Selected only" GroupName="SelectedObjects"
                                                 IsChecked="{Binding SelectedOnly, Mode=TwoWay}"
                                                 ToolTip.Tip="Exclusively use selected hit objects." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Updating" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Customize on which events the virtual objects get updated." />
                                <StackPanel>
                                    <RadioButton Content="Any change" GroupName="Updating"
                                                 IsChecked="{Binding UpdatingAnyChange, Mode=TwoWay}" />
                                    <RadioButton Content="Time change" GroupName="Updating"
                                                 IsChecked="{Binding UpdatingTimeChange, Mode=TwoWay}" />
                                    <RadioButton Content="osu! activated" GroupName="Updating"
                                                 IsChecked="{Binding UpdatingOsuActivated, Mode=TwoWay}" />
                                    <RadioButton Content="Hotkey down" GroupName="Updating"
                                                 IsChecked="{Binding UpdatingHotkeyDown, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Minimal diff" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           ToolTip.Tip="Similar virtual objects get merged together to reduce clutter. This field sets the minimal difference that two objects must have to not get merged together." />
                                <TextBox Width="150" VerticalAlignment="Bottom"
                                         materialAssists:TextFieldAssist.Label="Minimal difference"
                                         Text="{Binding Preferences.AcceptableDifference, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                                         ToolTip.Tip="Similar virtual objects get merged together to reduce clutter. This field sets the minimal difference that two objects must have to not get merged together." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Keep running" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Keep the tool running when another tool is selected." />
                                <ToggleSwitch OnContent="" OffContent=""
                                              IsChecked="{Binding KeepRunning, Mode=TwoWay}"
                                              ToolTip.Tip="Keep the tool running when another tool is selected." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="See playfield" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Show the osu! playfield boundary." />
                                <ToggleSwitch OnContent="" OffContent=""
                                              IsChecked="{Binding Preferences.VisiblePlayfieldBoundary, Mode=TwoWay}"
                                              ToolTip.Tip="Show the osu! playfield boundary." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Width="100" Text="Debug" VerticalAlignment="Center" Margin="0,0,0,6"
                                           ToolTip.Tip="Show the Geometry Dashboard debug border." />
                                <ToggleSwitch OnContent="" OffContent=""
                                              IsChecked="{Binding Preferences.DebugEnabled, Mode=TwoWay}"
                                              ToolTip.Tip="Show the Geometry Dashboard debug border." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Appearance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Name}" IsExpanded="False" Margin="0,0,0,5"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Margin="20, 10">
                                        <Grid ColumnDefinitions="130,*,70" MinHeight="35">
                                            <TextBlock Text="Colour" Grid.Column="0" VerticalAlignment="Center" />
                                            <ColorPicker Grid.Column="1" HorizontalAlignment="Left"
                                                         Color="{Binding Color, Mode=TwoWay}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" MinHeight="35" Spacing="10">
                                            <TextBlock Text="Opacity" Width="120" VerticalAlignment="Center" />
                                            <Slider Width="300" VerticalAlignment="Center" TickFrequency="0.01" Orientation="Horizontal"
                                                    Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}"/>
                                            <TextBox Classes="compact" Width="40" VerticalAlignment="Center"
                                                     Text="{Binding Opacity, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" MinHeight="35" Spacing="10">
                                            <TextBlock Text="Thickness" Width="120" VerticalAlignment="Center" />
                                            <Slider Width="300" VerticalAlignment="Center" TickFrequency="1" Orientation="Horizontal"
                                                    Minimum="1" Maximum="10" Value="{Binding Thickness, Mode=TwoWay}"/>
                                            <TextBox Classes="compact" Width="40" VerticalAlignment="Center"
                                                     Text="{Binding Thickness, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" MinHeight="35" Spacing="10">
                                            <TextBlock Text="DashStyle" Width="120" VerticalAlignment="Center" />
                                            <ComboBox Classes="compact" Width="305" VerticalAlignment="Center" ItemsSource="{Binding DashStyles}"
                                                      Margin="5, 0, 0, 0"
                                                      SelectedItem="{Binding DashStyle, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" MinHeight="35" Spacing="10"
                                                    IsVisible="{Binding HasSizeOption}">
                                            <TextBlock Text="Size" Width="120" VerticalAlignment="Center" />
                                            <Slider Width="300" VerticalAlignment="Center" TickFrequency="1" Orientation="Horizontal"
                                                    Minimum="1" Maximum="10" Value="{Binding Size, Mode=TwoWay}"/>
                                            <TextBox Classes="compact" Width="40" VerticalAlignment="Center"
                                                     Text="{Binding Size, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="10">
            <Grid ColumnDefinitions="*,*">
                <Button Width="200" Content="Apply" CornerRadius="10" Command="{Binding ApplyCommand}" />
                <Button Grid.Column="1" Width="200" Content="Cancel" CornerRadius="10" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
