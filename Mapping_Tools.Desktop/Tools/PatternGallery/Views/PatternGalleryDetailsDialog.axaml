<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:patternGallery="clr-namespace:Mapping_Tools.Desktop.Tools.PatternGallery.Interactions"
        x:Class="Mapping_Tools.Desktop.Tools.PatternGallery.Views.PatternGalleryDetailsDialog"
        x:DataType="patternGallery:PatternGalleryDetailsViewModel"
        Width="440"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
    <Grid RowDefinitions="*,Auto" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBox Text="{Binding Name, Mode=TwoWay}"
                         PlaceholderText="Name"
                         ToolTip.Tip="The name shown for this pattern." />
                <TextBlock Text="{Binding CreationTimeText, StringFormat='Creation time: {0}'}" />
                <TextBlock Text="{Binding LastUsedTimeText, StringFormat='Time of last use: {0}'}" />
                <TextBlock Text="{Binding UseCountText, StringFormat='Usage count: {0}'}" />
                <TextBlock Text="{Binding ObjectCountText, StringFormat='Object count: {0}'}" />
                <TextBlock Text="{Binding DurationText, StringFormat='Duration: {0}'}" />
                <TextBlock Text="{Binding BeatLengthText, StringFormat='Beat length: {0}'}" />
                <TextBlock Text="{Binding FileName, StringFormat='File name: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}"
                           Foreground="{DynamicResource MaterialValidationErrorBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Classes="dialog-action"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="88"
                    MinHeight="36" />
            <Button Classes="dialog-action"
                    Content="OK"
                    Command="{Binding AcceptCommand}"
                    MinWidth="88"
                    MinHeight="36"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>
