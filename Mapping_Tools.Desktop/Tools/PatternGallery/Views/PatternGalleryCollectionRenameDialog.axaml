<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Mapping_Tools.Desktop.Localization"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:patternGallery="clr-namespace:Mapping_Tools.Desktop.Tools.PatternGallery.ViewModels"
             x:Class="Mapping_Tools.Desktop.Tools.PatternGallery.Views.PatternGalleryCollectionRenameDialog"
             x:DataType="patternGallery:PatternGalleryCollectionRenameViewModel">
    <Grid Margin="8" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0">
            <TextBox x:Name="NewNameTextBox"
                     materialAssists:TextFieldAssist.Label="{loc:Tr PatternGallery_NewName}"
                     Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     MinWidth="100"
                     Margin="0,0,0,5"
                         ToolTip.Tip="{loc:Tr PatternGallery_CollectionNameTip}" />
            <TextBox materialAssists:TextFieldAssist.Label="{loc:Tr PatternGallery_DirectoryName}"
                     Text="{Binding NewFolderName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     MinWidth="100"
                     Margin="0,0,0,5"
                         ToolTip.Tip="{loc:Tr PatternGallery_CollectionFolderTip}" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Classes="dialog-action primary"
                    Theme="{StaticResource MaterialFlatButton}"
                         Content="{loc:Tr Common_Accept}"
                    Command="{Binding AcceptCommand}"
                    IsDefault="True" />
            <Button Classes="dialog-action primary"
                    Theme="{StaticResource MaterialFlatButton}"
                         Content="{loc:Tr Common_CancelUppercase}"
                    Command="{Binding CancelCommand}"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
