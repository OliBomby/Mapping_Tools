<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.TumourGenerator.ViewModels"
             xmlns:adapter="using:Mapping_Tools.Desktop.Tools.TumourGenerator.Adapters"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:toolControls="using:Mapping_Tools.Desktop.Tools.TumourGenerator.Controls"
             xmlns:converters="using:Mapping_Tools.Desktop.Converters"
             xmlns:toolConverters="using:Mapping_Tools.Desktop.Tools.TumourGenerator.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Class="Mapping_Tools.Desktop.Tools.TumourGenerator.Views.TumourGeneratorView"
             x:DataType="vm:TumourGeneratorViewModel"
             x:CompileBindings="True">
    <UserControl.Resources>
        <converters:BooleanNotConverter x:Key="BooleanNotConverter" />
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <toolConverters:TumourGeneratorTemplateIconConverter x:Key="TumourGeneratorTemplateIconConverter" />
        <converters:CircleSizeToThicknessConverter x:Key="CircleSizeToThicknessConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto">
            <controls:ToolViewHeader Grid.Row="0"
                                     Title="Tumour Generator 2"
                                     IsQuickRunSupported="True"
                                     HelpText="Tumour Generator 2 generates copious amounts of tumours on sliders.&#x0a;You can adjust the shape and size of tumours and choose where they should be placed along the path.&#x0a;You can also generate multiple layers of tumours. A layer will either merge the tumours with the tumours of the previous layer or place the tumours on top of the previous tumours.&#x0a;Enable the Advanced toggle and click the ... button to edit how a parameter changes over time. Use the arrow keys on the sliders to do fine adjustments.&#x0a;To get started, select a slider in your beatmap and click 'Preview slider' to preview changes or click the run button to instantly generate tumours on the selected sliders." />

            <Grid Grid.Row="1" ColumnDefinitions="200,Auto,200,Auto,*">
                <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="0,0,10,0">
                    <ListBox Grid.Row="0" ItemsSource="{Binding TumourLayers}"
                             VerticalAlignment="Top"
                             SelectionMode="Single"
                             SelectedItem="{Binding CurrentLayer, Mode=TwoWay}"
                             SelectedIndex="{Binding CurrentLayerIndex, Mode=TwoWay}"
                             ToolTip.Tip="Select a tumour layer to edit its settings.">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="DockPanel.Dock" Value="Bottom" />
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <DockPanel LastChildFill="False" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="adapter:ObservableTumourLayer">
                                <Grid ColumnDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch">
                                    <ToggleButton IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                  Margin="2,0"
                                                  VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Grid.Column="1"
                                                                Kind="{Binding TumourTemplateEnum, Converter={StaticResource TumourGeneratorTemplateIconConverter}}"
                                                                Width="24" Height="24" Margin="5,0"
                                                                VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             TextWrapping="NoWrap"
                                             MinWidth="50"
                                             Margin="5,0"
                                             PointerPressed="LayerNamePointerPressed"
                                             ToolTip.Tip="The name shown for this tumour layer." />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*">
                        <Button Grid.Column="0" Command="{Binding AddCommand}" ToolTip.Tip="Add a new tumour layer.">
                            <materialIcons:MaterialIcon Kind="Plus" Width="22" Height="22" />
                        </Button>
                        <Button Grid.Column="1" Command="{Binding RemoveCommand}"
                                ToolTip.Tip="Remove the selected tumour layer.">
                            <materialIcons:MaterialIcon Kind="TrashCan" Width="22" Height="22" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding CopyCommand}"
                                ToolTip.Tip="Copy the selected tumour layer.">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="22" Height="22" />
                        </Button>
                        <Button Grid.Column="3" Command="{Binding RaiseCommand}"
                                ToolTip.Tip="Move selected layer to higher in the list.">
                            <materialIcons:MaterialIcon Kind="KeyboardArrowUp" Width="22" Height="22" />
                        </Button>
                        <Button Grid.Column="4" Command="{Binding LowerCommand}"
                                ToolTip.Tip="Move selected layer to lower in the list.">
                            <materialIcons:MaterialIcon Kind="KeyboardArrowDown" Width="22" Height="22" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Margin="5,10"
                                Value="{Binding Scale, Mode=TwoWay}" ToolTip.Tip="Tumour scale" />
                        <Slider Minimum="0" Maximum="10" TickFrequency="1" SmallChange="0.1" LargeChange="1" Margin="5,10"
                                IsSnapToTickEnabled="True"
                                Value="{Binding CircleSize, Mode=TwoWay}" ToolTip.Tip="Circle Size" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                            <ToggleSwitch IsChecked="{Binding AdvancedOptions}"
                                          ToolTip.Tip="Show advanced controls. Allows for fine control of parameters and changes over time." />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Advanced" />
                        </StackPanel>
                        <CheckBox Content="Debug construction" IsChecked="{Binding DebugConstruction}"
                                  ToolTip.Tip="Skip intelligent path reconstruction." />
                        <CheckBox Content="Only middle anchors" IsChecked="{Binding JustMiddleAnchors}"
                                  ToolTip.Tip="Construct path with only the middle anchors of all tumours." />
                        <CheckBox Content="Fix SV" IsChecked="{Binding FixSv}"
                                  ToolTip.Tip="Automatically adjust SV such that the slider keeps the same duration after getting tumours." />
                        <CheckBox Content="Delegate SV to BPM" IsChecked="{Binding DelegateToBpm}"
                                  IsEnabled="{Binding FixSv}"
                                  ToolTip.Tip="Use BPM to determine the velocity of the slider instead of greenline SV." />
                        <CheckBox Content="Remove slider ticks" IsChecked="{Binding RemoveSliderTicks}"
                                  IsEnabled="{Binding RemoveSliderTicksEnabled}"
                                  ToolTip.Tip="Use a NaN greenline to remove slider ticks from the slider." />
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="1"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Width="2"
                              Background="{DynamicResource MaterialDividerBrush}"
                              Margin="0,10" />

                <ScrollViewer Grid.Column="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <StackPanel Margin="10,0">
                        <TextBlock FontWeight="Bold" Text="Template" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding TumourTemplates}"
                                  SelectedItem="{Binding CurrentLayer.TumourTemplateEnum, Mode=TwoWay}"
                                  materialAssists:ComboBoxAssist.Label="Template"
                                  ToolTip.Tip="Tumour template. Determines the shape of the tumour." />
                        <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Scale" />
                    <toolControls:ValueOrGraphControl GraphState="{Binding CurrentLayer.TumourScale, Mode=TwoWay}"
                                                  IsVisible="{Binding AdvancedOptions}"
                                                  ToolTip.Tip="The scale of the tumour determines how far it protrudes from the slider." />
                    <Slider Minimum="0" Maximum="500"
                            Value="{Binding CurrentLayer.TumourScaleValue, Mode=TwoWay}"
                            IsVisible="{Binding AdvancedOptions, Converter={StaticResource BooleanNotConverter}}"
                            ToolTip.Tip="The scale of the tumour determines how far it protrudes from the slider." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Length" />
                    <toolControls:ValueOrGraphControl GraphState="{Binding CurrentLayer.TumourLength, Mode=TwoWay}"
                                                  IsVisible="{Binding AdvancedOptions}"
                                                  ToolTip.Tip="The length of the tumour determines how much length it takes up on the slider." />
                    <Slider Minimum="0" Maximum="500"
                            Value="{Binding CurrentLayer.TumourLengthValue, Mode=TwoWay}"
                            IsVisible="{Binding AdvancedOptions, Converter={StaticResource BooleanNotConverter}}"
                            ToolTip.Tip="The length of the tumour determines how much length it takes up on the slider." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Angle" />
                    <toolControls:ValueOrGraphControl GraphState="{Binding CurrentLayer.TumourRotation, Mode=TwoWay}"
                                                  IsVisible="{Binding AdvancedOptions}"
                                                  ToolTip.Tip="The angle of the tumour determines which way the tumour points in relation to the slider." />
                    <Slider Minimum="0" Maximum="360"
                            Value="{Binding CurrentLayer.TumourRotationValue, Mode=TwoWay}"
                            IsVisible="{Binding AdvancedOptions, Converter={StaticResource BooleanNotConverter}}"
                            ToolTip.Tip="The angle of the tumour determines which way the tumour points in relation to the slider." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Parameter"
                               IsVisible="{Binding CurrentLayer.TumourTemplate.NeedsParameter}" />
                    <toolControls:ValueOrGraphControl GraphState="{Binding CurrentLayer.TumourParameter, Mode=TwoWay}"
                                                  IsVisible="{Binding TumourParameterGraphVisible}"
                                                  ToolTip.Tip="The special parameter changes the shape of this tumour template." />
                    <Slider Minimum="0" Maximum="500"
                            Value="{Binding CurrentLayer.TumourParameterValue, Mode=TwoWay}"
                            IsVisible="{Binding CurrentLayer.TumourTemplate.NeedsParameter}"
                            ToolTip.Tip="The special parameter changes the shape of this tumour template." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Wrapping" />
                    <ComboBox ItemsSource="{Binding WrappingModes}"
                              SelectedItem="{Binding CurrentLayer.WrappingMode, Mode=TwoWay}"
                              materialAssists:ComboBoxAssist.Label="Wrapping"
                              ToolTip.Tip="The wrapping mode controls how the tumour wraps around the shape of the slider." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Sidedness" />
                    <ComboBox ItemsSource="{Binding TumourSides}"
                              SelectedItem="{Binding CurrentLayer.TumourSidedness, Mode=TwoWay}"
                              materialAssists:ComboBoxAssist.Label="Sidedness"
                              ToolTip.Tip="Tumour sidedness. Determines on which side of the slider to place the tumours." />
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding CurrentLayer.TumourSidedness, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Random}">
                        <TextBox
                            Text="{Binding CurrentLayer.RandomSeed, Mode=TwoWay, Converter={StaticResource InvariantInt32Converter}}"
                            materialAssists:TextFieldAssist.Label="Random seed"
                            ToolTip.Tip="The random seed which determines the sequence of tumour sidedness for this layer." />
                        <Button Grid.Column="1" Command="{Binding RandomizeCommand}" Margin="5,0,0,0"
                                VerticalAlignment="Bottom"
                                ToolTip.Tip="Randomize the random seed.">
                            <materialIcons:MaterialIcon Kind="DiceMultiple" Width="22" Height="22" />
                        </Button>
                    </Grid>
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Distance" />
                    <toolControls:ValueOrGraphControl GraphState="{Binding CurrentLayer.TumourDistance, Mode=TwoWay}"
                                                  IsVisible="{Binding AdvancedOptions}"
                                                  ToolTip.Tip="The tumour distance determines the distance between the centre of each tumour." />
                    <Slider Minimum="5" Maximum="500"
                            Value="{Binding CurrentLayer.TumourDistanceValue, Mode=TwoWay}"
                            IsVisible="{Binding AdvancedOptions, Converter={StaticResource BooleanNotConverter}}"
                            ToolTip.Tip="The tumour distance determines the distance between the centre of each tumour." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Count" />
                    <TextBox
                        Text="{Binding CurrentLayer.TumourCount, Mode=TwoWay, Converter={StaticResource InvariantInt32Converter}}"
                        IsVisible="{Binding AdvancedOptions}"
                        materialAssists:TextFieldAssist.Label="Count"
                        ToolTip.Tip="The number of tumours to place on the slider. If 0 this count will be automatically determined using the distance and slider length." />
                    <Slider Minimum="0" Maximum="20" Value="{Binding CurrentLayer.TumourCount, Mode=TwoWay}"
                            IsVisible="{Binding AdvancedOptions, Converter={StaticResource BooleanNotConverter}}"
                            ToolTip.Tip="The number of tumours to place on the slider. If 0 this count will be automatically determined using the distance and slider length." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="Start" />
                    <TextBox
                        Text="{Binding CurrentLayer.TumourStart, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                        IsVisible="{Binding AdvancedOptions}"
                        materialAssists:TextFieldAssist.Label="Start"
                        ToolTip.Tip="The progression along the slider where to start the placement of tumours. 0 is the slider head, 1 is the slider end. If 'Absolute range' is checked, then this distance is expressed in osu! pixels." />
                    <Slider Minimum="{Binding TumourStartSliderMin}"
                            Maximum="{Binding TumourRangeSliderMax}"
                            SmallChange="{Binding TumourRangeSliderSmallChange}"
                            Value="{Binding CurrentLayer.TumourStart, Mode=TwoWay}"
                            ToolTip.Tip="The progression along the slider where to start the placement of tumours. 0 is the slider head, 1 is the slider end. If 'Absolute range' is checked, then this distance is expressed in osu! pixels." />
                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="End" />
                    <TextBox
                        Text="{Binding CurrentLayer.TumourEnd, Mode=TwoWay, Converter={StaticResource InvariantDoubleConverter}}"
                        IsVisible="{Binding AdvancedOptions}"
                        materialAssists:TextFieldAssist.Label="End"
                        ToolTip.Tip="The progression along the slider where to end the placement of tumours. 0 is the slider head, 1 is the slider end. If 'Absolute range' is checked, then this distance is expressed in osu! pixels." />
                    <Slider Minimum="0"
                            Maximum="{Binding TumourRangeSliderMax}"
                            SmallChange="{Binding TumourRangeSliderSmallChange}"
                            Value="{Binding CurrentLayer.TumourEnd, Mode=TwoWay}"
                            ToolTip.Tip="The progression along the slider where to end the placement of tumours. 0 is the slider head, 1 is the slider end. If 'Absolute range' is checked, then this distance is expressed in osu! pixels." />
                    <CheckBox Content="Absolute range" Margin="0,10,0,0"
                              IsChecked="{Binding CurrentLayer.UseAbsoluteRange, Mode=TwoWay}"
                              ToolTip.Tip="Enable this to change the meaning of the Scale, Length, Distance, Start, and End fields to mean length in osu! pixels instead of length relative to the length of the slider." />
                    <CheckBox Content="Recalculate" Margin="0,5,0,0"
                              IsChecked="{Binding CurrentLayer.Recalculate, Mode=TwoWay}"
                              ToolTip.Tip="Whether to recalculate the distances and angles of the slider before applying this layer. If true, tumours will be placed on top of tumours of the previous layers as if they were part of the slider, instead of merging with those tumours." />
                    <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </ScrollViewer>

                <GridSplitter Grid.Column="3"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Width="2"
                              Background="{DynamicResource MaterialDividerBrush}"
                              Margin="0,10" />

                <Border Grid.Column="4"
                        Padding="10"
                        Margin="10,0,0,0"
                        Background="{DynamicResource MaterialPaperBrush}"
                        ToolTip.Tip="Result preview">
                    <controls:ObjectVisualiserControl HitObject="{Binding TumouredPreviewHitObject}"
                                                      ShowAnchors="True"
                                                      Thickness="{Binding CircleSize, Converter={StaticResource CircleSizeToThicknessConverter}}"
                                                      AnchorSize="6"
                                                      BorderThickness="0.1"
                                                      Fill="DarkSlateGray"
                                                      Stroke="YellowGreen"
                                                      SliderBallStroke="White" />
                </Border>
                <ProgressBar Grid.Column="4"
                             Height="4"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="10,0,0,0"
                             Maximum="1"
                             Value="1"
                             IsIndeterminate="{Binding IsProcessingPreview}"
                             IsVisible="{Binding IsProcessingPreview}" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" Margin="0,10,10,0" ColumnDefinitions="*,Auto,Auto">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding ImportModes}"
                              SelectedItem="{Binding ImportModeSetting, Mode=TwoWay}"
                              Margin="0,0,5,0"
                              VerticalAlignment="Top"
                              materialAssists:ComboBoxAssist.Label="Import mode"
                              ToolTip.Tip="Slider selection mode. Choose which sliders should be targeted by Tumour Generator 2." />
                    <TextBox Grid.Column="1"
                             Width="100"
                             Margin="5,0,5,2"
                             VerticalAlignment="Top"
                             IsVisible="{Binding TimeCodeVisible}"
                             Text="{Binding TimeCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             materialAssists:TextFieldAssist.Label="Time code"
                             ToolTip.Tip="Input a time code here. Example time code: 00:56:823 (1) - " />
                    <Button Grid.Column="2"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding ImportCommand}"
                            ToolTip.Tip="Import sliders into the preview.">
                        Preview slider
                    </Button>
                </Grid>

                <controls:ToolRunButton Grid.Column="1"
                                        Margin="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        RunCommand="{Binding RunCommand}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock VerticalAlignment="Bottom" FontWeight="Bold" Opacity="0.58" Text="Made by OliBomby" />
            <controls:ToolProgressBar Grid.Column="1" Height="20" Margin="20,0" Maximum="100"
                                      Value="{Binding Progress}" />
        </Grid>
    </Grid>
</UserControl>
