<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Mapping_Tools.Desktop.Localization"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.SliderMerger.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Class="Mapping_Tools.Desktop.Tools.SliderMerger.Views.SliderMergerView"
             x:DataType="vm:SliderMergerViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid>
            <StackPanel>
                <controls:ToolViewHeader
                    Title="{loc:Tr SliderMerger_Title}"
                    IsQuickRunSupported="True"
                    HelpText="{loc:Tr SliderMerger_Help}" />

                <TextBox Width="258" HorizontalAlignment="Left" Margin="0,20,0,0"
                         materialAssists:TextFieldAssist.Label="{loc:Tr SliderMerger_LeniencyLabel}"
                         Text="{Binding Leniency, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                         ToolTip.Tip="{loc:Tr SliderMerger_LeniencyTip}" />

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0" HorizontalAlignment="Left">
                    <ComboBox Width="258" Cursor="Hand"
                              ItemsSource="{Binding ImportModes}"
                              SelectedItem="{Binding ImportModeSetting}"
                              materialAssists:ComboBoxAssist.Label="{loc:Tr SliderMerger_ObjectSelectionLabel}"
                              ToolTip.Tip="{loc:Tr SliderMerger_SelectionModeTip}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:TranslatedBinding Converter={x:Static loc:ToolChoiceConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Margin="15,0,0,0" Width="258"
                             IsVisible="{Binding TimeCodeVisible}"
                             materialAssists:TextFieldAssist.Label="{loc:Tr Common_TimeCodeLabel}"
                             Text="{Binding TimeCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="{loc:Tr SliderMerger_TimeCodeTip}" />
                </StackPanel>

                <ComboBox Margin="0,26,0,0" Width="258" Cursor="Hand" HorizontalAlignment="Left"
                          ItemsSource="{Binding ConnectionModes}"
                          SelectedItem="{Binding ConnectionModeSetting}"
                          materialAssists:ComboBoxAssist.Label="{loc:Tr SliderMerger_ConnectionModeLabel}"
                          ToolTip.Tip="{loc:Tr SliderMerger_ConnectionModeTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:TranslatedBinding Converter={x:Static loc:ToolChoiceConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Margin="0,26,0,0" Content="{loc:Tr SliderMerger_MergeOnSliderEnd}"
                          IsChecked="{Binding MergeOnSliderEnd}"
                          ToolTip.Tip="{loc:Tr SliderMerger_MergeOnSliderEndTip}" />
                <CheckBox Margin="0,5,0,0" Content="{loc:Tr SliderMerger_LinearCurve}"
                          IsChecked="{Binding LinearOnLinear}"
                          ToolTip.Tip="{loc:Tr SliderMerger_LinearCurveTip}" />
            </StackPanel>

            <controls:ToolRunButton Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    RunCommand="{Binding RunCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock VerticalAlignment="Bottom" FontWeight="Bold" Opacity="0.58"
                       Text="{loc:Tr Common_MadeByOliBomby}" TextWrapping="NoWrap" />
            <controls:ToolProgressBar Grid.Column="1" Height="20" Margin="20,0,20,0"
                                      Maximum="100" Value="{Binding Progress}" />
        </Grid>
    </Grid>
</UserControl>
