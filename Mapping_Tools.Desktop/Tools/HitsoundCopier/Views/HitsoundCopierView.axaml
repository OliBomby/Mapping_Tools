<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.HitsoundCopier.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:Mapping_Tools.Desktop.Localization"
             x:Class="Mapping_Tools.Desktop.Tools.HitsoundCopier.Views.HitsoundCopierView"
             x:DataType="vm:HitsoundCopierViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid>
            <StackPanel Margin="0,0,0,100">
                <controls:ToolViewHeader
                    Title="Hitsound Copier"
                    IsQuickRunSupported="True"
                    HelpText="{loc:Tr HitsoundCopier_Help}" />

                <Grid Margin="0,20,0,0" ColumnDefinitions="*,Auto,5,Auto">
                    <TextBox Margin="0,0,5,0" materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_SourcePath}"
                             Text="{Binding PathFrom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="{loc:Tr HitsoundCopier_SourceTip}" />
                    <Button Grid.Column="1" Classes="flat path-picker" Cursor="Hand"
                            Command="{Binding ImportLoadCommand}"
                            VerticalAlignment="Bottom" ToolTip.Tip="{loc:Tr HitsoundCopier_FetchBeatmap}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="RestoreFromTrash" />
                    </Button>
                    <Button Grid.Column="3" Classes="flat path-picker" Cursor="Hand"
                            Command="{Binding ImportBrowseCommand}"
                            VerticalAlignment="Bottom" ToolTip.Tip="{loc:Tr HitsoundCopier_BrowseBeatmaps}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="Folder" />
                    </Button>
                </Grid>
                <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto,5,Auto">
                    <TextBox Margin="0,0,5,0" materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_TargetPath}"
                             Text="{Binding PathTo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="{loc:Tr HitsoundCopier_TargetTip}" />
                    <TextBlock Grid.Column="1" Margin="3,15,2,0" Padding="0,0,3,0" FontStyle="Italic"
                               Text="{Binding ExportMapCountText}" />
                    <Button Grid.Column="2" Classes="flat path-picker" Cursor="Hand"
                            Command="{Binding ExportLoadCommand}"
                            VerticalAlignment="Bottom" ToolTip.Tip="{loc:Tr HitsoundCopier_FetchBeatmap}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="RestoreFromTrash" />
                    </Button>
                    <Button Grid.Column="4" Classes="flat path-picker" Cursor="Hand"
                            Command="{Binding ExportBrowseCommand}"
                            VerticalAlignment="Bottom" ToolTip.Tip="{loc:Tr HitsoundCopier_BrowseBeatmaps}">
                        <materialIcons:MaterialIcon Width="30" Height="30" Kind="Folder" />
                    </Button>
                </Grid>

                <ComboBox Margin="0,20,0,0" Cursor="Hand" ItemsSource="{Binding CopyModes}"
                          SelectedItem="{Binding CopyMode}"
                          materialAssists:ComboBoxAssist.Label="{loc:Tr HitsoundCopier_CopyMode}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopyModeTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:TranslatedBinding Converter={x:Static loc:ToolChoiceConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Margin="0,10,0,0"
                         materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_TemporalLeniency}"
                         Text="{Binding TemporalLeniency, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                         ToolTip.Tip="{loc:Tr HitsoundCopier_TemporalLeniencyTip}" />

                <CheckBox Margin="0,10,0,0" IsChecked="{Binding CopyHitsounds}" Content="{loc:Tr HitsoundCopier_CopyHitsounds}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopyHitsoundsTip}" />
                <CheckBox IsChecked="{Binding CopyBodyHitsounds}" Content="{loc:Tr HitsoundCopier_CopyBodyHitsounds}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopyBodyHitsoundsTip}" />
                <CheckBox IsChecked="{Binding CopySampleSets}" Content="{loc:Tr HitsoundCopier_CopySampleSets}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopySampleSetsTip}" />
                <CheckBox IsChecked="{Binding CopyVolumes}" Content="{loc:Tr HitsoundCopier_CopyVolumes}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopyVolumesTip}" />
                <CheckBox Margin="20,0,0,0" IsVisible="{Binding CopyVolumes}"
                          IsChecked="{Binding AlwaysPreserve5Volume}"
                          Content="{loc:Tr HitsoundCopier_PreserveFivePercent}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_PreserveFivePercentTip}" />
                <CheckBox IsChecked="{Binding CopyStoryboardedSamples}" Content="{loc:Tr HitsoundCopier_CopyStoryboardSamples}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopyStoryboardSamplesTip}" />
                <StackPanel Margin="20,0,0,0" IsVisible="{Binding CopyStoryboardedSamples}">
                    <CheckBox IsChecked="{Binding IgnoreHitsoundSatisfiedSamples}"
                              Content="{loc:Tr HitsoundCopier_IgnoreSatisfiedSamples}"
                              ToolTip.Tip="{loc:Tr HitsoundCopier_IgnoreSatisfiedSamplesTip}" />
                    <CheckBox IsChecked="{Binding IgnoreWheneverHitsound}"
                              Content="{loc:Tr HitsoundCopier_IgnoreAnyHitsound}"
                              ToolTip.Tip="{loc:Tr HitsoundCopier_IgnoreAnyHitsoundTip}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding CopyToSliderTicks}" Content="{loc:Tr HitsoundCopier_CopyTicks}"
                          IsEnabled="{Binding SmartCopyModeSelected}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopyTicksTip}" />
                <CheckBox IsChecked="{Binding CopyToSliderSlides}" Content="{loc:Tr HitsoundCopier_CopySlides}"
                          IsEnabled="{Binding SmartCopyModeSelected}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_CopySlidesTip}" />
                <TextBox Margin="0,0,0,5" IsVisible="{Binding StartIndexBoxVisible}"
                         IsEnabled="{Binding SmartCopyModeSelected}"
                         materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_StartIndex}"
                         Text="{Binding StartIndex, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantInt32Converter}}"
                         ToolTip.Tip="{loc:Tr HitsoundCopier_StartIndexTip}" />

                <CheckBox IsChecked="{Binding MuteSliderends}" Content="{loc:Tr HitsoundCopier_MuteSliderEnds}"
                          ToolTip.Tip="{loc:Tr HitsoundCopier_MuteSliderEndsTip}" />
                <StackPanel IsVisible="{Binding MuteSliderends}">
                    <TextBlock FontSize="14" Margin="0,10,0,0" Text="{loc:Tr HitsoundCopier_FilterHeading}" />
                    <Grid ColumnDefinitions="Auto,5,Auto,5,*">
                        <TextBox MinWidth="100" FontSize="14" Cursor="Hand"
                                 materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_AllBeatDivisors}"
                                 Text="{Binding BeatDivisors, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource BeatDivisorArrayToStringConverter}}"
                                 ToolTip.Tip="{loc:Tr HitsoundCopier_AllBeatDivisorsTip}" />
                        <TextBox Grid.Column="2" MinWidth="100" FontSize="14" Cursor="Hand"
                                 materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_MutedBeatDivisors}"
                                 Text="{Binding MutedDivisors, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource BeatDivisorArrayToStringConverter}}"
                                 ToolTip.Tip="{loc:Tr HitsoundCopier_MutedBeatDivisorsTip}" />
                        <TextBox Grid.Column="4" FontSize="14" Cursor="Hand"
                                 materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_MinimumDuration}"
                                 Text="{Binding MinLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 ToolTip.Tip="{loc:Tr HitsoundCopier_MinimumDurationTip}" />
                    </Grid>
                    <TextBlock FontSize="14" Margin="0,10,0,0" Text="{loc:Tr HitsoundCopier_MutedConfig}" />
                    <Grid ColumnDefinitions="*,5,70">
                        <TextBox Classes="compact" materialAssists:TextFieldAssist.Label="{loc:Tr HitsoundCopier_MutedCustomIndex}"
                                 Text="{Binding MutedIndex, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantInt32Converter}}"
                                 ToolTip.Tip="{loc:Tr HitsoundCopier_MutedCustomIndexTip}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding MutedSampleSets}"
                                  SelectedItem="{Binding MutedSampleSet}" Classes="compact" Cursor="Hand"
                                  ToolTip.Tip="{loc:Tr HitsoundCopier_MutedSampleSetTip}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
            <controls:ToolRunButton Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    RunCommand="{Binding RunCommand}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0">
                <WrapPanel VerticalAlignment="Bottom">
                    <TextBlock TextWrapping="NoWrap" FontWeight="Bold" Opacity="0.58"
                               Text="{loc:Tr Common_FooterMadeBy}" />
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="1">
                <controls:ToolProgressBar Height="20" Margin="20,0,20,0"
                                          Background="{x:Null}" BorderBrush="{x:Null}"
                                          Maximum="100" Value="{Binding Progress}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
