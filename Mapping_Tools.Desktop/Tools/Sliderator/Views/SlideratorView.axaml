<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Mapping_Tools.Desktop.Localization"
             xmlns:vm="using:Mapping_Tools.Desktop.Tools.Sliderator.ViewModels"
             xmlns:controls="using:Mapping_Tools.Desktop.Controls"
             xmlns:materialDesign="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:graph="clr-namespace:Mapping_Tools.Desktop.Controls.Graph"
             ClipToBounds="False"
             x:Class="Mapping_Tools.Desktop.Tools.Sliderator.Views.SlideratorView"
             x:DataType="vm:SlideratorViewModel"
             x:CompileBindings="True">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:ToolViewHeader Grid.Row="0"
                    Title="{loc:Tr Sliderator_Title}"
                                 IsQuickRunSupported="True"
                    HelpText="{loc:Tr Sliderator_Help}" />

        <Grid Grid.Row="1" RowDefinitions="2*,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <graph:GraphControl Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                x:Name="GraphControlElement"
                                GraphState="{Binding GraphState, Mode=TwoWay}"
                                MinMarkerSpacing="20"
                                Margin="43,0,0,43"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalAxisVisible="{Binding HorizontalAxisVisible}"
                                VerticalAxisVisible="{Binding VerticalAxisVisible}"
                                StartPointLockedY="{Binding StartPointLockedY}"
                                IsEditable="True"
                                MarkerSnappingHorizontal="True"
                                MarkerSnappingVertical="True"
                                MarkerSnappingRangeVertical="0.01" />

            <materialDesign:Card Grid.Row="1"
                                 Grid.Column="2"
                                 Margin="0"
                                 Padding="10"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 ToolTip.Tip="{loc:Tr Sliderator_ResultPreview}">
                <controls:ObjectVisualiserControl x:Name="PreviewControl"
                                                  Width="200"
                                                  HitObject="{Binding VisibleHitObject}"
                                                  CustomPixelLength="{Binding PreviewPixelLength}"
                                                  Progress="{Binding PreviewProgress}"
                                                  Thickness="50"
                                                  BorderThickness="0.1"
                                                  Fill="DarkSlateGray"
                                                  Stroke="YellowGreen"
                                                  SliderBallStroke="White"
                                                  ToolTip.Tip="{loc:Tr Sliderator_PreviewMotionTip}" />
            </materialDesign:Card>

            <ScrollViewer Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="0"
                          Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ComboBox Grid.Column="0"
                                  Classes="compact"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ImportModes}"
                                  SelectedItem="{Binding ImportModeSetting}"
                                  Margin="0,0,5,0"
                                  ToolTip.Tip="{loc:Tr Sliderator_ImportModeTip}" />
                        <TextBox Grid.Column="1"
                                 Classes="compact"
                                 VerticalAlignment="Center"
                                 Text="{Binding TimeCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 IsVisible="{Binding TimeCodeVisible}"
                                 Margin="5,0,5,0"
                                 Width="100"
                                 ToolTip.Tip="{loc:Tr Sliderator_TimeCodeTip}" />
                        <Button Grid.Column="2"
                                Command="{Binding ImportCommand}"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                ToolTip.Tip="{loc:Tr Sliderator_ImportSlidersTip}">
                            Import sliders
                        </Button>
                    </Grid>

                    <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LoadedHitObjectsCountText}" />
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="0,0,5,0"
                                                           x:Name="MoveLeftButton"
                                                           Click="MoveLeft"
                                                           ToolTip.Tip="{loc:Tr Sliderator_PreviousSliderTip}">
                                <materialIcons:MaterialIcon Kind="KeyboardArrowLeft" Width="24" Height="24" />
                            </materialDesign:FloatingButton>
                            <materialDesign:FloatingButton Classes="mini light no-transitions" x:Name="MoveRightButton"
                                                           Click="MoveRight"
                                                           ToolTip.Tip="{loc:Tr Sliderator_NextSliderTip}">
                                <materialIcons:MaterialIcon Kind="KeyboardArrowRight" Width="24" Height="24" />
                            </materialDesign:FloatingButton>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0" ColumnDefinitions="*,*,*">
                        <TextBox Grid.Column="0"
                                 Margin="0,0,10,0"
                                 Text="{Binding GraphBeats, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 materialAssists:TextFieldAssist.Label="{loc:Tr Common_BeatLength}"
                                 ToolTip.Tip="{loc:Tr Sliderator_GraphBeatsTip}" />
                        <TextBox Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Text="{Binding BeatsPerMinute, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 materialAssists:TextFieldAssist.Label="{loc:Tr Sliderator_BpmLabel}"
                                 ToolTip.Tip="{loc:Tr Sliderator_BpmTip}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding GlobalSv, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                                 materialAssists:TextFieldAssist.Label="{loc:Tr Sliderator_GlobalSvLabel}"
                                 ToolTip.Tip="{loc:Tr Sliderator_GlobalSvTip}" />
                    </Grid>

                    <TextBox Margin="0,20,0,0"
                             Text="{Binding ExportTime, Converter={StaticResource TimeToStringConverter}, UpdateSourceTrigger=LostFocus}"
                             materialAssists:TextFieldAssist.Label="{loc:Tr Sliderator_TimeLabel}"
                             ToolTip.Tip="{loc:Tr Sliderator_ExportTimeTip}" />
                    <ComboBox Margin="0,10,0,0"
                              Classes="compact"
                              ItemsSource="{Binding ExportModes}"
                              SelectedItem="{Binding ExportModeSetting}"
                              ToolTip.Tip="{loc:Tr Sliderator_ExportModeTip}" />

                    <RadioButton Content="{loc:Tr Sliderator_ExportSlider}"
                                 Margin="0,10,0,0"
                                 GroupName="exportFormat"
                                 IsChecked="{Binding ExportAsNormal}"
                                 ToolTip.Tip="{loc:Tr Sliderator_ExportSliderTip}" />
                    <RadioButton Content="{loc:Tr Sliderator_ExportStream}"
                                 GroupName="exportFormat"
                                 IsChecked="{Binding ExportAsStream}"
                                 ToolTip.Tip="{loc:Tr Sliderator_ExportStreamTip}" />
                    <RadioButton Content="{loc:Tr Sliderator_ExportInvisible}"
                                 GroupName="exportFormat"
                                 IsChecked="{Binding ExportAsInvisibleSlider}"
                                 ToolTip.Tip="{loc:Tr Sliderator_ExportInvisibleTip}" />

                    <CheckBox Content="{loc:Tr Sliderator_ManualSv}"
                              Margin="0,10,0,5"
                              IsChecked="{Binding ManualVelocity}"
                              IsVisible="{Binding ExportAsNormal}"
                              ToolTip.Tip="{loc:Tr Sliderator_ManualSvTip}" />
                    <TextBox IsVisible="{Binding ExportAsNormal}"
                             IsEnabled="{Binding ManualVelocity}"
                             Margin="0,0,0,5"
                             Text="{Binding NewVelocity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                             materialAssists:TextFieldAssist.Label="{loc:Tr Sliderator_NewSvLabel}"
                             ToolTip.Tip="{loc:Tr Sliderator_NewSvTip}" />
                    <TextBox IsVisible="{Binding ExportAsNormal}"
                             Text="{Binding MinDendrite, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                             materialAssists:TextFieldAssist.Label="{loc:Tr Sliderator_MinimumTumourLengthLabel}"
                             ToolTip.Tip="{loc:Tr Sliderator_MinTumourTip}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{loc:Tr Sliderator_ExpectedSegments}"
                                   ToolTip.Tip="{loc:Tr Sliderator_ExpectedSegmentsTip}" />
                        <TextBlock Text="{Binding ExpectedSegments}"
                                   ToolTip.Tip="{loc:Tr Sliderator_ExpectedSegmentsTip}" />
                    </StackPanel>

                    <CheckBox Content="{loc:Tr Sliderator_DelegateSv}"
                              Margin="0,15,0,0"
                              IsChecked="{Binding DelegateToBpm}"
                              IsVisible="{Binding ExportAsNormal}"
                              ToolTip.Tip="{loc:Tr Sliderator_DelegateSvTip}" />
                    <CheckBox Content="{loc:Tr Sliderator_RemoveTicks}"
                              IsChecked="{Binding RemoveSliderTicks}"
                              IsVisible="{Binding ExportAsNormal}"
                              IsEnabled="{Binding DelegateToBpm}"
                              ToolTip.Tip="{loc:Tr Sliderator_RemoveTicksTip}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,10,0" RowDefinitions="Auto,Auto,Auto">
                <Grid Grid.Row="0" Margin="8,0,8,0" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             MaxWidth="140"
                             MinWidth="100"
                             HorizontalAlignment="Left"
                             IsVisible="{Binding ExportAsNormal}"
                             Text="{Binding VelocityLimit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource InvariantDoubleConverter}}"
                             materialAssists:TextFieldAssist.Label="{loc:Tr Sliderator_SvLimitLabel}"
                             ToolTip.Tip="{loc:Tr Sliderator_VelocityLimitTip}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="0,0,5,0"
                                                       Command="{Binding ScaleCompleteCommand}"
                                                       ToolTip.Tip="{loc:Tr Sliderator_ScaleToCompletion}">
                            <materialIcons:MaterialIcon Kind="RelativeScale" Width="24" Height="24" />
                        </materialDesign:FloatingButton>
                        <materialDesign:FloatingButton Classes="mini light no-transitions" Margin="0,0,5,0"
                                                       Command="{Binding ClearGraphCommand}" ToolTip.Tip="{loc:Tr Sliderator_ResetGraph}">
                            <materialIcons:MaterialIcon Kind="Rocket" Width="24" Height="24" />
                        </materialDesign:FloatingButton>
                        <materialDesign:FloatingButton Classes="mini Accent no-transitions" Margin="5,0,0,0"
                                                       Command="{Binding GraphToggleCommand}"
                                                       ToolTip.Tip="{loc:Tr Sliderator_ToggleGraphMode}">
                            <TextBlock Text="{Binding GraphModeText}" FontWeight="Bold"
                                       Width="24" Height="24"
                                       TextAlignment="Center"
                                       LineHeight="24"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </materialDesign:FloatingButton>
                    </StackPanel>
                </Grid>

                <Slider Grid.Row="1"
                        Minimum="1"
                        Maximum="16"
                        Classes="Discrete"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="{Binding BeatSnapDivisor}"
                        ToolTip.Tip="{loc:Tr Sliderator_BeatSnapDivisorTip}"
                        Margin="8,15,8,5" />

                <WrapPanel Grid.Row="2"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left"
                           Margin="5,10,5,0">
                    <CheckBox IsChecked="{Binding ShowRedAnchors}"
                              Content="{loc:Tr Sliderator_ShowRedAnchors}"
                              Margin="0,0,5,0"
                              ToolTip.Tip="{loc:Tr Sliderator_ShowRedAnchorsTip}" />
                    <CheckBox IsChecked="{Binding ShowGraphAnchors}"
                              Content="{loc:Tr Sliderator_ShowGraphAnchors}"
                              ToolTip.Tip="{loc:Tr Sliderator_ShowGraphAnchorsTip}" />
                </WrapPanel>
            </Grid>

            <controls:ToolRunButton Grid.Row="1"
                                    Grid.Column="3"
                                    Width="70"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    RunCommand="{Binding RunCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <TextBlock VerticalAlignment="Bottom"
                       FontWeight="Bold"
                       Opacity="0.58"
                       TextWrapping="NoWrap"
                       Text="{loc:Tr Sliderator_MadeBy}" />
            <controls:ToolProgressBar Grid.Column="1"
                                      Height="20"
                                      Margin="20,0"
                                      Background="{x:Null}"
                                      BorderBrush="{x:Null}"
                                      Maximum="100"
                                      Value="{Binding Progress}" />
        </Grid>
    </Grid>
</UserControl>
