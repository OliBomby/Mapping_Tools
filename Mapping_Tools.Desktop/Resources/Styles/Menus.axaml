<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="MenuItem:not(.Menu):not(:separator)">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="MenuItem:not(.Menu) /template/ AccessText#PART_MenuItemText">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="MenuItem:not(.Menu) /template/ ContentPresenter#PART_Icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="MenuItem /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0,4" />
    </Style>
</Styles>
