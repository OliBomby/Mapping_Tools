<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyVersion>1.12.30</AssemblyVersion>
    <FileVersion>1.12.30</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mt_icon.ico</ApplicationIcon>
    <!-- Disable Avalonia's build-time usage statistics task; developer tools remain enabled. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.0" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotAvalonia" Version="3.*" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageReference Include="Material.Avalonia" Version="3.17.0" />
    <PackageReference Include="Material.Avalonia.DataGrid" Version="3.17.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapping_Tools.Application\Mapping_Tools.Application.csproj" />
    <ProjectReference Include="..\Mapping_Tools.Infrastructure\Mapping_Tools.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="RenamePublishedAppHost" AfterTargets="Publish">
    <PropertyGroup>
      <PublishedAppHostSource>$(PublishDir)Mapping_Tools.Desktop</PublishedAppHostSource>
      <PublishedAppHostDestination>$(PublishDir)Mapping Tools</PublishedAppHostDestination>
      <PublishedAppHostSource Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-x64'">$(PublishDir)Mapping_Tools.Desktop.exe</PublishedAppHostSource>
      <PublishedAppHostDestination Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-x64'">$(PublishDir)Mapping Tools.exe</PublishedAppHostDestination>
    </PropertyGroup>

    <Move SourceFiles="$(PublishedAppHostSource)"
          DestinationFiles="$(PublishedAppHostDestination)"
          Condition="Exists('$(PublishedAppHostSource)')" />
  </Target>

  <!-- These assemblies back Windows-only live-editor, overlay, and global-hook
       adapters. The shared Infrastructure assembly keeps compile-time
       references, while Unix bundles omit those unused runtime assets. -->
  <Target Name="ExcludeWindowsOnlyRuntimeAssets"
          BeforeTargets="_GetCurrentAndPriorPublishFileWrites;_ComputeResolvedFilesToPublishTypes"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or
                     '$(RuntimeIdentifier)' == 'linux-arm64' Or
                     '$(RuntimeIdentifier)' == 'osx-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-arm64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)' == 'EditorReader' Or
                                        '%(ResolvedFileToPublish.Filename)' == 'NonInvasiveKeyboardHookLibrary.Core' Or
                                        '%(ResolvedFileToPublish.Filename)' == 'NAudio.Wasapi'" />
    </ItemGroup>
  </Target>
</Project>
