<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="using:Mapping_Tools.Desktop.Converters"
             xmlns:local="using:Mapping_Tools.Desktop"
             x:Class="Mapping_Tools.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme. "Dark" and "Light" force a variant. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Mapping_Tools.Desktop/Resources/MappingToolsColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvariantInt32Converter x:Key="InvariantInt32Converter" />
            <converters:InvariantDoubleConverter x:Key="InvariantDoubleConverter" />
            <converters:ConstantTimeSpanConverter x:Key="ConstantTimeSpanConverter" />
            <converters:DarkThemeConverter x:Key="DarkThemeConverter" />
            <converters:BeatDivisorArrayToStringConverter x:Key="BeatDivisorArrayToStringConverter" />
            <converters:StringArrayToStringConverter x:Key="StringArrayToStringConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <material:MaterialTheme BaseTheme="Dark"
                                PrimaryColor="Blue"
                                SecondaryColor="Lime" />
        <materialIcons:MaterialIconStyles />

        <!-- Application-wide Material compatibility overrides. -->
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Resources/Styles/Validation.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Resources/Styles/TextBoxes.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Resources/Styles/Menus.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Resources/Styles/ComboBoxes.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Resources/Styles/Buttons.axaml" />

        <!-- Styles owned by code-only custom controls. -->
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Controls/TimelineControl.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Controls/HotkeyEditor.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Controls/ToolRunButton.axaml" />
        <StyleInclude Source="avares://Mapping_Tools.Desktop/Controls/ToolProgressBar.axaml" />
    </Application.Styles>
</Application>
